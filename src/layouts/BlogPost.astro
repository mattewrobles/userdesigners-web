---
import { render } from "astro:content";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Giscus from "../components/Giscus.astro";
import fs from "fs";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, category, date, updatedDate, readTime, heroImage, ogImage } = post.data;
const { Content, headings } = await render(post);
const allPosts = (await getCollection("blog"))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const relatedPosts = allPosts
  .filter(p => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 2);
const framerCSS = fs.readFileSync("src/styles/framer.css", "utf-8")
  .replace(/<\/?style[^>]*>/g, "");
const ogImgFinal = (ogImage || heroImage)
  ? new URL(ogImage || heroImage, Astro.site).href
  : "";
const hasToc = headings && headings.length > 0;
---

<!doctype html>
<html lang="es-EC">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | UserDesigners</title>
  <meta name="description" content={post.data.description || title} />
  <link rel="icon" href="/assets/local/o5LtTMyVT0hoY6m1F1q3smw3kq4.png" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:type" content="article" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={post.data.description || title} />
  {ogImgFinal && <meta property="og:image" content={ogImgFinal} />}
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={post.data.description || title} />
  {ogImgFinal && <meta name="twitter:image" content={ogImgFinal} />}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description: post.data.description || title,
    image: ogImgFinal,
    datePublished: date,
    dateModified: updatedDate || date,
    url: new URL(Astro.url.pathname, Astro.site).href,
    mainEntityOfPage: { "@type": "WebPage", "@id": new URL(Astro.url.pathname, Astro.site).href },
    author: { "@type": "Organization", name: "UserDesigners", url: "https://www.userdesigners.com" },
    publisher: { "@type": "Organization", name: "UserDesigners", url: "https://www.userdesigners.com",
      logo: { "@type": "ImageObject", url: "https://www.userdesigners.com/assets/local/o5LtTMyVT0hoY6m1F1q3smw3kq4.png" }
    }
  })} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;500;600&family=Inter:wght@400;500;600&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/tokens.css" />
  <style is:global set:html={framerCSS}></style>
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-PDZVJDG9Y5"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){window.dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-PDZVJDG9Y5');
  </script>
  <!-- Microsoft Clarity -->
  <script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "xytbbmamwh");
  </script>
</head>
<body style="margin:0;background-color:var(--surface-1);color:var(--text-primary);font-family:Inter,sans-serif">
  <div class="bg-blob"></div>
  <div id="reading-progress"></div>
  <Navbar />

  <article style="position:relative;z-index:1;padding-top:80px">
    {heroImage && (
      <div class="post-hero-img">
        <img src={heroImage} alt={title} />
      </div>
    )}

    <div class="post-layout">
      <div class="post-content">
        <header class="post-header">
          {category && (
            <span class="post-category">{category}</span>
          )}
          <h1 class="post-title">{title}</h1>
          {post.data.description && <p class="post-description">{post.data.description}</p>}
          <div class="post-meta">
            <time datetime={date}>{new Date(date).toLocaleDateString("es-EC", { year: "numeric", month: "long", day: "numeric" })}</time>
            {updatedDate && <span style="font-style:italic">· Actualizado {new Date(updatedDate).toLocaleDateString("es-EC", { year: "numeric", month: "long", day: "numeric" })}</span>}
            {readTime && <span>{readTime} de lectura</span>}
          </div>
        </header>

        <div class="prose">
          <Content />
        </div>

        <Giscus />

        {relatedPosts.length > 0 && (
          <div class="related-posts">
            <h2 class="related-title">Artículos relacionados</h2>
            <div class="related-grid">
              {relatedPosts.map(p => (
                <a href={`/blog/${p.id}`} class="related-card">
                  {p.data.heroImage && (
                    <div class="related-card-img">
                      <img src={p.data.heroImage} alt={p.data.title} loading="lazy" />
                    </div>
                  )}
                  <div class="related-card-body">
                    <span class="related-card-cat">{p.data.category}</span>
                    <h3 class="related-card-title">{p.data.title}</h3>
                    <span class="related-card-meta">{p.data.readTime || "4 min"} de lectura</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        <footer class="post-footer">
          <a href="/blog" class="back-link">← Volver al blog</a>
        </footer>
      </div>

      {hasToc && (
        <aside class="post-sidebar">
          <nav class="toc">
            <h3 class="toc-title">En este artículo</h3>
            <ul class="toc-list">
              {headings.filter(h => h.depth <= 3).map(h => (
                <li class="toc-item" style={{ marginLeft: `${(h.depth - 2) * 12}px` }}>
                  <a href={`#${h.slug}`} class="toc-link">{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="toc-cta">
            <p>¿Tienes un proyecto similar?</p>
            <a href="https://wa.me/593961026799?text=Hola%20UserDesigners%2C%20quiero%20agendar%20una%20sesi%C3%B3n" target="_blank" rel="noopener">Charlemos</a>
          </div>
        </aside>
      )}
    </div>
  </article>

  <Footer />
</body>
</html>

<script>
  import { animate, scroll, inView } from "motion";

  const progress = document.getElementById("reading-progress");
  if (progress) {
    scroll(
      (p) => {
        progress.style.transform = `scaleX(${p})`;
      },
      { target: document.body }
    );
  }

  const headers = document.querySelectorAll(".prose h2, .prose h3");
  headers.forEach((h) => {
    inView(h, () => {
      animate(h, { opacity: [0, 1], y: [20, 0] }, { duration: 0.5, easing: "ease-out" });
    }, { margin: "-80px" });
  });

  const images = document.querySelectorAll(".prose img");
  images.forEach((img) => {
    inView(img, () => {
      animate(img, { opacity: [0, 1], transform: ["translateY(20px)", "translateY(0)"] }, { duration: 0.6, easing: "ease-out" });
    }, { margin: "-60px" });
  });

  const relatedCards = document.querySelectorAll(".related-card");
  relatedCards.forEach((card, i) => {
    inView(card, () => {
      animate(card, { opacity: [0, 1], y: [20, 0] }, { duration: 0.4, easing: "ease-out", delay: i * 0.1 });
    }, { margin: "-40px" });
  });

  const tocLinks = document.querySelectorAll(".toc-link");
  tocLinks.forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      const id = link.getAttribute("href")?.slice(1);
      if (id) {
        const target = document.getElementById(id);
        if (target) {
          target.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      }
    });
  });
</script>

<style is:global>
  #reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--accent-default), #998dd0);
    transform-origin: 0 50%;
    transform: scaleX(0);
    z-index: 1000;
    pointer-events: none;
  }

  .post-hero-img {
    width: 100%;
    max-width: 1100px;
    max-height: 420px;
    overflow: hidden;
    margin: 0 auto 48px;
    padding: 0 24px;
  }
  .post-hero-img img {
    width: 100%;
    height: auto;
    max-height: 420px;
    object-fit: cover;
    display: block;
    border-radius: 24px;
  }

  .post-layout {
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 48px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    align-items: start;
  }
  .post-content {
    max-width: 720px;
    min-width: 0;
  }
  .post-sidebar {
    position: sticky;
    top: 100px;
  }
  .post-header {
    margin-bottom: 48px;
  }
  .post-category {
    display: inline-block;
    padding: 4px 14px;
    background: var(--accent-muted);
    border: 1px solid var(--border-accent);
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    color: var(--accent-default);
    margin-bottom: 20px;
    font-family: Inter, sans-serif;
  }
  .post-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 0 0 16px;
    color: var(--text-primary);
  }
  .post-description {
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0 0 24px;
    font-family: Inter, sans-serif;
  }
  .post-meta {
    display: flex;
    gap: 20px;
    align-items: center;
    color: var(--text-secondary);
    font-size: 14px;
    font-family: Inter, sans-serif;
    flex-wrap: wrap;
  }

  .prose {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text-primary);
  }
  .prose h2 {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 56px 0 20px;
    scroll-margin-top: 80px;
  }
  .prose h3 {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-primary);
    margin: 40px 0 16px;
    scroll-margin-top: 80px;
  }
  .prose p {
    margin: 0 0 20px;
  }
  .prose ul, .prose ol {
    margin: 0 0 20px;
    padding-left: 24px;
  }
  .prose li {
    margin-bottom: 8px;
  }
  .prose strong {
    color: var(--text-primary);
    font-weight: 600;
  }
  .prose a {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--border-accent);
  }
  .prose a:hover {
    text-decoration-color: var(--text-primary);
  }
  .prose blockquote {
    border-left: 2px solid var(--surface-glass-hover);
    margin: 32px 0;
    padding: 4px 0 4px 24px;
    color: var(--text-primary);
    font-style: italic;
  }
  .prose img {
    border-radius: 12px;
    margin: 32px 0;
    width: 100%;
  }
  .prose hr {
    border: none;
    border-top: 1px solid var(--border-subtle);
    margin: 48px 0;
  }

  .toc {
    padding: 24px;
    border-radius: 16px;
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    margin-bottom: 24px;
  }
  .toc-title {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin: 0 0 16px;
  }
  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .toc-item {
    margin: 0 !important;
    padding: 0 !important;
  }
  .toc-link {
    font-size: 13px;
    color: var(--text-tertiary);
    text-decoration: none;
    line-height: 1.4;
    font-family: Inter, sans-serif;
    transition: color 0.2s;
    display: block;
  }
  .toc-link:hover {
    color: var(--text-primary);
  }
  .toc-cta {
    padding: 20px 24px;
    border-radius: 16px;
    background: var(--accent-muted);
    border: 1px solid var(--accent-muted);
  }
  .toc-cta p {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 500;
    color: var(--text-primary);
    margin: 0 0 12px;
    line-height: 1.4;
  }
  .toc-cta a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 42px;
    padding: 0 22px;
    border-radius: 10px;
    background: var(--border-subtle);
    border: 1px solid var(--surface-glass-hover);
    color: var(--text-primary);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    font-family: var(--font-body);
    transition: all 0.25s ease;
  }
  .toc-cta a:hover {
    background: var(--border-accent);
    border-color: var(--text-disabled);
    transform: translateY(-1px);
  }

  .related-posts {
    margin-top: 64px;
    padding-top: 48px;
    border-top: 1px solid var(--border-subtle);
  }
  .related-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    color: var(--text-primary);
    margin: 0 0 24px;
    letter-spacing: -0.02em;
  }
  .related-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    border-radius: 14px;
    overflow: hidden;
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .related-card:hover {
    border-color: var(--border-strong);
    background: var(--surface-2);
  }
  .related-card-img {
    height: 140px;
    overflow: hidden;
  }
  .related-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .related-card:hover .related-card-img img {
    transform: scale(1.05);
  }
  .related-card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .related-card-cat {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-family: Inter, sans-serif;
  }
  .related-card-title {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--text-primary);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-card-meta {
    font-size: 12px;
    color: var(--text-disabled);
    font-family: Inter, sans-serif;
  }

  .post-footer {
    margin-top: 48px;
    padding: 32px 0;
  }
  .back-link {
    color: var(--text-tertiary);
    text-decoration: none;
    font-size: 14px;
    font-family: Inter, sans-serif;
    transition: color 0.2s;
  }
  .back-link:hover {
    color: var(--text-primary);
  }

  .bg-blob {
    position: fixed;
    top: 50%;
    left: 50%;
    width: 800px;
    height: 800px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: conic-gradient(from 0deg, #d045ff, #998dd0, #0044ff, #ffbf00, #d045ff);
    filter: blur(140px);
    opacity: 0.12;
    pointer-events: none;
    z-index: 0;
    animation: blob-spin 25s linear infinite;
  }
  @keyframes blob-spin {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  @media (max-width: 900px) {
    .post-layout {
      grid-template-columns: 1fr;
    }
    .post-sidebar {
      display: none;
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 768px) {
    .post-layout {
      padding: 0 16px;
    }
    .post-content {
      max-width: 100%;
    }
    .post-hero-img {
      max-width: 100%;
      border-radius: 16px;
      max-height: 240px;
      margin-bottom: 32px;
    }
    .post-hero-img img {
      max-height: 240px;
    }
    .post-header {
      margin-bottom: 32px;
    }
    .post-title {
      font-size: clamp(26px, 8vw, 32px);
    }
    .post-description {
      font-size: 16px;
    }
    .prose {
      font-size: 16px;
    }
    .prose h2 {
      font-size: 24px;
    }
    .prose h3 {
      font-size: 19px;
    }
  }
  @media (max-width: 480px) {
    .post-layout {
      padding: 0 12px;
    }
    .post-hero-img {
      max-width: 100%;
    }
    .post-meta {
      font-size: 12px;
      gap: 12px;
    }
    .related-grid {
      gap: 12px;
    }
  }
</style>