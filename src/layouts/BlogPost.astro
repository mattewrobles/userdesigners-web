---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import fs from "fs";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, category, date, readTime, heroImage, ogImage } = post.data;
const { Content } = await render(post);
const framerCSS = fs.readFileSync("src/styles/framer-global.css", "utf-8");
const ogImgFinal = ogImage || heroImage;
---

<!doctype html>
<html lang="es-EC">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | UserDesigners</title>
  <meta name="description" content={post.data.description || title} />
  <link rel="icon" href="/assets/local/o5LtTMyVT0hoY6m1F1q3smw3kq4.png" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:type" content="article" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={post.data.description || title} />
  {ogImgFinal && <meta property="og:image" content={ogImgFinal} />}
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={post.data.description || title} />
  {ogImgFinal && <meta name="twitter:image" content={ogImgFinal} />}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description: post.data.description || title,
    image: ogImage || heroImage,
    datePublished: date,
    author: { "@type": "Organization", name: "UserDesigners" },
    publisher: { "@type": "Organization", name: "UserDesigners" }
  })} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style is:global set:html={framerCSS}></style>
</head>
<body style="margin:0;background-color:#030303;color:#fff;font-family:Inter,sans-serif">
  <div class="bg-blob"></div>
  <Navbar />
  
  <article style="position:relative;z-index:1">
    {heroImage && (
      <div style="width:100%;max-height:420px;overflow:hidden;margin-bottom:48px;border-radius:0">
        <img src={heroImage} alt={title} style="width:100%;height:auto;max-height:420px;object-fit:cover;display:block" />
      </div>
    )}

    <div style="max-width:720px;margin:0 auto;padding:0 24px">
      <header style="margin-bottom:48px">
        {category && (
          <span style="display:inline-block;padding:4px 12px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.08);border-radius:20px;font-size:13px;font-weight:500;color:rgba(255,255,255,0.6);margin-bottom:20px;font-family:Inter,sans-serif">
            {category}
          </span>
        )}
        <h1 style="font-family:'Familjen Grotesk',sans-serif;font-size:clamp(32px,5vw,52px);font-weight:500;line-height:1.15;letter-spacing:-0.03em;margin:0 0 20px;color:#fff">
          {title}
        </h1>
        <div style="display:flex;gap:20px;align-items:center;color:rgba(255,255,255,0.4);font-size:14px;font-family:Inter,sans-serif">
          <time datetime={date}>{new Date(date).toLocaleDateString("es-EC", { year: "numeric", month: "long", day: "numeric" })}</time>
          {readTime && <span>{readTime} de lectura</span>}
        </div>
      </header>

      <div class="prose" style="font-size:17px;line-height:1.8;color:rgba(255,255,255,0.85)">
        <Content />
      </div>

      <footer style="margin-top:80px;padding:40px 0;border-top:1px solid rgba(255,255,255,0.06)">
        <a href="/blog" style="color:rgba(255,255,255,0.5);text-decoration:none;font-size:14px;font-family:Inter,sans-serif">
          ← Volver al blog
        </a>
      </footer>
    </div>
  </article>

  <Footer />
</body>
</html>

<style is:global>
  .prose h2 {
    font-family: 'Familjen Grotesk', sans-serif;
    font-size: 28px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 56px 0 20px;
  }
  .prose h3 {
    font-family: 'Familjen Grotesk', sans-serif;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.4;
    color: rgba(255,255,255,0.9);
    margin: 40px 0 16px;
  }
  .prose p {
    margin: 0 0 20px;
  }
  .prose ul, .prose ol {
    margin: 0 0 20px;
    padding-left: 24px;
  }
  .prose li {
    margin-bottom: 8px;
  }
  .prose strong {
    color: #fff;
    font-weight: 600;
  }
  .prose a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(255,255,255,0.2);
  }
  .prose a:hover {
    text-decoration-color: rgba(255,255,255,0.6);
  }
  .prose blockquote {
    border-left: 2px solid rgba(255,255,255,0.1);
    margin: 32px 0;
    padding: 4px 0 4px 24px;
    color: rgba(255,255,255,0.6);
    font-style: italic;
  }
  .prose img {
    border-radius: 12px;
    margin: 32px 0;
    width: 100%;
  }
  .prose hr {
    border: none;
    border-top: 1px solid rgba(255,255,255,0.06);
    margin: 48px 0;
  }
  .framer-bjhdpb { align-items: flex-start !important; }
  .framer-WOlJs .framer-bjhdpb { overflow: visible !important; }
  .framer-WOlJs.framer-v-1lvxs1p .framer-84xib0 { height: auto !important; }
  .framer-WOlJs.framer-v-1lvxs1p .framer-1m25ze8-container { width: auto !important; }
  .framer-WOlJs .framer-1d3wp7v { width: auto !important; }
  #navbar [data-framer-appear-id] { opacity: 1 !important; transform: none !important; }
  .framer-wse24v { margin-left: auto !important; margin-right: auto !important; }
  .framer-WOlJs { background-color: #030303 !important; padding-top: 0 !important; margin-left: auto !important; margin-right: auto !important; }
  .framer-WOlJs.framer-v-ib24dp { padding-top: 0 !important; }
  .bg-blob {
    position: fixed;
    top: 50%;
    left: 50%;
    width: 800px;
    height: 800px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: conic-gradient(from 0deg, #d045ff, #998dd0, #0044ff, #ffbf00, #d045ff);
    filter: blur(140px);
    opacity: 0.12;
    pointer-events: none;
    z-index: 0;
    animation: blob-spin 25s linear infinite;
  }
  @keyframes blob-spin {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }
</style>