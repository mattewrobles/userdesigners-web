---
interface Props {
  as?: "span" | "p" | "div";
  "data-gsap"?: string;
}

const { as = "span", "data-gsap": dataGsap } = Astro.props;
const Tag = as;
const attrs = dataGsap ? { "data-gsap": dataGsap } : {};
---

<Tag class="section-label" {...attrs}><slot /></Tag>

<style>
  .section-label {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0 0 28px;
  }
</style>
