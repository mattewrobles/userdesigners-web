---
interface Props {
  speed?: number; // segundos por loop
  reverse?: boolean;
  gap?: number;
}

const { speed = 20, reverse = false, gap = 48 } = Astro.props;
const trackId = `marquee-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="marquee" id={trackId} data-speed={speed} data-reverse={reverse} data-gap={gap} style={`--marquee-gap:${gap}px`}>
  <div class="marquee-track">
    <div class="marquee-group"><slot /></div>
    <div class="marquee-group" aria-hidden="true"><slot /></div>
  </div>
</div>
<script>
  import { animate } from "motion";

  document.querySelectorAll(".marquee").forEach((root) => {
    const track = root.querySelector(".marquee-track");
    const groups = root.querySelectorAll(".marquee-group");
    const speed = Number(root.dataset.speed || 20);
    const reverse = root.dataset.reverse === "true";
    const gap = Number(root.dataset.gap || 48);

    if (track && groups.length >= 2) {
      const distance = groups[0].scrollWidth + gap;
      // reverse invierte la dirección real: empieza desplazado y vuelve a 0 (derecha)
      const from = reverse ? `-${distance}px` : "0px";
      const to = reverse ? "0px" : `-${distance}px`;
      animate(
        track,
        { x: [from, to] },
        {
          duration: speed,
          repeat: Infinity,
          ease: "linear",
        }
      );
    }
  });
</script>

<style>
  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 12.5%, rgba(0, 0, 0, 1) 87.5%, rgba(0, 0, 0, 0) 100%);
    mask-image: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 12.5%, rgba(0, 0, 0, 1) 87.5%, rgba(0, 0, 0, 0) 100%);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .marquee-group {
    display: flex;
    align-items: center;
    gap: var(--marquee-gap, var(--space-9));
    padding-right: var(--marquee-gap, var(--space-9));
    flex-shrink: 0;
  }
  .marquee-group > * {
    margin-right: 0;
  }
</style>
