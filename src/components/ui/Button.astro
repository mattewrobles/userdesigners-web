---
interface Props {
  href?: string;
  variant?: "primary" | "ghost" | "link" | "stroke" | "danger";
  size?: "sm" | "md" | "lg";
  target?: "_blank" | "_self";
  rel?: string;
  strokeFill?: boolean;
}

const {
  href = "#",
  variant = "primary",
  size = "md",
  target = "_self",
  rel,
  strokeFill = true,
} = Astro.props;
const classes = `btn btn--${variant} btn--${size}`;
---

{
  href ? (
    <a href={href} class={classes} target={target} rel={rel || (target === "_blank" ? "noopener" : undefined)}>
      {variant === "stroke" && (
        <>
          <span class="btn-stroke" aria-hidden="true"></span>
          <span class="btn-fill" aria-hidden="true"></span>
        </>
      )}
      <span class="btn-label"><slot /></span>
    </a>
  ) : (
    <button class={classes}>
      {variant === "stroke" && (
        <>
          <span class="btn-stroke" aria-hidden="true"></span>
          <span class="btn-fill" aria-hidden="true"></span>
        </>
      )}
      <span class="btn-label"><slot /></span>
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 500;
    border-radius: var(--radius-btn);
    cursor: pointer;
    position: relative;
    transition: background var(--duration-fast) ease, border-color var(--duration-fast) ease, color var(--duration-fast) ease, opacity var(--duration-fast) ease;
    border: 2px solid transparent;
    box-sizing: border-box;
    white-space: nowrap;
  }

  .btn--sm { padding: 10px 18px; font-size: 14px; }
  .btn--md { padding: 12px 28px; font-size: 15px; }
  .btn--lg { padding: 16px 32px; font-size: 16px; }

  /* Glass — botón "Filled" del navbar (rgba 255 0.08 + borde 2px) */
  .btn--primary {
    background: var(--surface-glass);
    border-color: var(--border-strong);
    color: var(--text-primary);
  }
  .btn--primary:hover { background: var(--surface-glass-hover); }

  /* Ghost — transparente con borde tenue */
  .btn--ghost {
    background: transparent;
    border-color: var(--border-subtle);
    color: var(--text-secondary);
  }
  .btn--ghost:hover { color: var(--text-primary); border-color: var(--border-strong); }

  /* Link — azul con underline (único uso del accent en botones) */
  .btn--link {
    background: transparent;
    border: none;
    color: var(--accent-default);
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .btn--link:hover { opacity: 0.85; }
  /* Stroke — botón del hero (borde blanco animado, como Framer) */
  .btn--stroke {
    background: rgba(255, 255, 255, 0.05);
    border: none;
    border-radius: var(--radius-btn);
    color: var(--text-primary);
    overflow: visible;
    padding: 12px 20px;
  }
  /* Halo: barrido de luz que cruza el borde inferior (shine sweep, como Framer) */
  .btn-stroke {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-btn);
    overflow: hidden;
    pointer-events: none;
  }
  /* la onda de luz: gradiente radial anclado que barre de izquierda a derecha */
  .btn-stroke::before {
    content: "";
    position: absolute;
    top: -20%;
    bottom: -20%;
    width: 36%;
    left: -40%;
    background: radial-gradient(ellipse at center, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.25) 45%, rgba(255, 255, 255, 0) 75%);
    filter: blur(3px);
    -webkit-filter: blur(3px);
    animation: btn-stroke-sweep 3.5s ease-in-out infinite;
    will-change: transform;
  }
  .btn--stroke:hover .btn-stroke::before {
    animation-duration: 2s; /* barre más rápido en hover */
  }
  /* Hover sutil: el borde completo se aclara gradualmente */
  .btn--stroke:hover {
    background: rgba(255, 255, 255, 0.09);
  }
  .btn--stroke:hover .btn-fill {
    opacity: 0.9;
  }
  .btn-fill {
    position: absolute;
    inset: 2px;
    background: var(--stroke-fill);
    border-radius: calc(var(--radius-btn) - 2px);
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .btn-label { position: relative; z-index: 1; }

  /* la onda entra por la izquierda, cruza y sale, con pausa elegante */
  @keyframes btn-stroke-sweep {
    0%   { transform: translateX(0) scaleX(0.6); opacity: 0; }
    8%   { opacity: 0.9; }
    45%  { transform: translateX(330%) scaleX(1); opacity: 0.9; }
    60%  { transform: translateX(420%) scaleX(1.1); opacity: 0; }
    100% { transform: translateX(420%) scaleX(1.1); opacity: 0; }
  }

  /* Danger — para acciones destructivas */
  .btn--danger {
    background: transparent;
    border-color: rgba(227, 103, 83, 0.5);
    color: rgb(227, 103, 83);
  }
  .btn--danger:hover { background: rgba(227, 103, 83, 0.1); }

  .btn:focus-visible {
    outline: 2px solid var(--accent-default);
    outline-offset: 2px;
  }

  /* Mobile: botones full-width en grids de acción */
  @media (max-width: 809.98px) {
    .btn--lg { padding: 14px 26px; font-size: 15px; }
    .btn--stroke { padding: 11px 18px; }
  }
</style>
