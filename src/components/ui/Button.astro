---
interface Props {
  href?: string;
  variant?: "primary" | "ghost" | "link" | "stroke" | "danger";
  size?: "sm" | "md" | "lg";
  target?: "_blank" | "_self";
  rel?: string;
  strokeFill?: boolean;
}

const {
  href = "#",
  variant = "primary",
  size = "md",
  target = "_self",
  rel,
  strokeFill = true,
} = Astro.props;
const classes = `btn btn--${variant} btn--${size}`;
---

{
  href ? (
    <a href={href} class={classes} target={target} rel={rel || (target === "_blank" ? "noopener" : undefined)}>
      {variant === "stroke" && (
        <>
          <span class="btn-stroke" aria-hidden="true"><span class="btn-orbit"></span></span>
          <span class="btn-fill" aria-hidden="true"></span>
        </>
      )}
      <span class="btn-label"><slot /></span>
    </a>
  ) : (
    <button class={classes}>
      {variant === "stroke" && (
        <>
          <span class="btn-stroke" aria-hidden="true"><span class="btn-orbit"></span></span>
          <span class="btn-fill" aria-hidden="true"></span>
        </>
      )}
      <span class="btn-label"><slot /></span>
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 500;
    border-radius: var(--radius-btn);
    cursor: pointer;
    position: relative;
    transition: background var(--duration-fast) ease, border-color var(--duration-fast) ease, color var(--duration-fast) ease, opacity var(--duration-fast) ease;
    border: 2px solid transparent;
    box-sizing: border-box;
    white-space: nowrap;
  }

  .btn--sm { padding: 10px 18px; font-size: 14px; }
  .btn--md { padding: 12px 28px; font-size: 15px; }
  .btn--lg { padding: 16px 32px; font-size: 16px; }

  /* Glass — botón "Filled" del navbar (rgba 255 0.08 + borde 2px) */
  .btn--primary {
    background: var(--surface-glass);
    border-color: var(--border-strong);
    color: var(--text-primary);
  }
  .btn--primary:hover { background: var(--surface-glass-hover); }

  /* Ghost — transparente con borde tenue */
  .btn--ghost {
    background: transparent;
    border-color: var(--border-subtle);
    color: var(--text-secondary);
  }
  .btn--ghost:hover { color: var(--text-primary); border-color: var(--border-strong); }

  /* Link — azul con underline (único uso del accent en botones) */
  .btn--link {
    background: transparent;
    border: none;
    color: var(--accent-default);
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .btn--link:hover { opacity: 0.85; }
  /* Stroke — botón del hero (borde blanco animado, como Framer) */
  .btn--stroke {
    background: rgba(255, 255, 255, 0.05);
    border: none;
    border-radius: var(--radius-btn);
    color: var(--text-primary);
    overflow: visible;
    padding: 12px 20px;
  }
  /* Halo exterior: spot de luz que orbita el borde por fuera (fluido, como Framer Motion) */
  .btn-stroke {
    position: absolute;
    inset: -2px; /* se proyecta por fuera del botón */
    border-radius: calc(var(--radius-btn) + 2px);
    overflow: hidden;
    pointer-events: none;
    transition: background 0.3s ease;
  }
  /* contenedor de órbita: más ancho que alto → la rotación genera elipse fluida */
  .btn-orbit {
    position: absolute;
    inset: -20px -60px;
    animation: btn-orbit-spin 4s linear infinite;
    will-change: transform;
    transition: opacity 0.3s ease;
  }
  .btn--stroke:hover .btn-orbit {
    animation-duration: 2.4s; /* apenas acelera en hover */
  }
  /* Hover sutil: el spot se funde y el borde se aclara gradualmente, sin saltar */
  .btn--stroke:hover .btn-orbit {
    opacity: 0.25;
  }
  .btn--stroke:hover .btn-stroke {
    background: rgba(255, 255, 255, 0.35);
  }
  .btn--stroke:hover {
    background: rgba(255, 255, 255, 0.09);
  }
  .btn--stroke:hover .btn-fill {
    opacity: 0.92;
  }
  /* el spot en el borde superior del contenedor rotante */
  .btn-orbit::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    width: 44px;
    height: 44px;
    transform: translate(-50%, -50%);
    background: radial-gradient(ellipse at center, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.35) 45%, rgba(255, 255, 255, 0) 75%);
    filter: blur(2px);
    -webkit-filter: blur(2px);
  }
  .btn-fill {
    position: absolute;
    inset: 2px;
    background: var(--stroke-fill);
    border-radius: calc(var(--radius-btn) - 2px);
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .btn-label { position: relative; z-index: 1; }

  /* rotación lineal continua = órbita fluida, sin saltos */
  @keyframes btn-orbit-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Danger — para acciones destructivas */
  .btn--danger {
    background: transparent;
    border-color: rgba(227, 103, 83, 0.5);
    color: rgb(227, 103, 83);
  }
  .btn--danger:hover { background: rgba(227, 103, 83, 0.1); }

  .btn:focus-visible {
    outline: 2px solid var(--accent-default);
    outline-offset: 2px;
  }

  /* Mobile: botones full-width en grids de acción */
  @media (max-width: 809.98px) {
    .btn--lg { padding: 14px 26px; font-size: 15px; }
    .btn--stroke { padding: 11px 18px; }
  }
</style>
