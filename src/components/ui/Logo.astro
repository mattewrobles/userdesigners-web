// colores de marca de la U: celeste, lila, dorado, coral (con blur en el original)
const brandColors = [
  "var(--ud-brand-sky)",
  "var(--ud-brand-lilac)",
  "var(--ud-brand-gold)",
  "var(--ud-brand-coral)",
];

const svgInner = uPaths
  .map((d, i) => `<path d="${d}" fill="${colored ? brandColors[i % brandColors.length] : "currentColor"}"></path>`)
  .join("");
---

<a
  href={href}
  class={"logo" + (colored ? " logo--colored" : "")}
  style={`--logo-h:${height}px`}
  aria-label="UserDesigners"
>
  <svg viewBox="0 0 213 43" class="logo-symbol" set:html={svgInner} />
  {variant === "full" && <span class="logo-word">UserDesigners</span>}
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text-primary);
  }
  .logo-symbol {
    height: var(--logo-h);
    width: auto;
    display: block;
  }
  .logo-word {
    font-family: var(--font-display);
    font-size: calc(var(--logo-h) * 0.68);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
  }
</style>
