---
type Role =
  | "display-1" | "display-2"
  | "heading-1" | "heading-2" | "heading-3"
  | "subheading" | "title"
  | "body-lg" | "body" | "body-sm" | "caption" | "overline";

interface Props {
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "p" | "span" | "div";
  role?: Role;
  size?: "2xs" | "xs" | "sm" | "base" | "md" | "lg" | "xl" | "2xl" | "3xl" | "4xl" | "5xl" | "6xl";
  weight?: "light" | "regular" | "semibold" | "bold";
  color?: "primary" | "secondary" | "tertiary" | "accent" | "disabled";
  family?: "display" | "body" | "subhead" | "ui" | "accent" | "mono";
  tracking?: "tight" | "snug" | "normal" | "wide" | "label";
  leading?: "none" | "tight" | "snug" | "normal" | "relaxed";
}

const {
  as = "p",
  role,
  size,
  weight = "regular",
  color = "primary",
  family = "body",
  tracking = "normal",
  leading = "normal",
} = Astro.props;
const Tag = as;
const roleCls = role ? `text-role text-role--${role}` : "";
const sizeCls = size ? `text-size text-size--${size}` : "";
const classes = [roleCls, sizeCls, `text--${color}`, `text--w-${weight}`, `text--f-${family}`, `text--tr-${tracking}`, `text--lh-${leading}`].filter(Boolean).join(" ");
---

<Tag class={classes}>
  <slot />
</Tag>

<style>
  .text-role { margin: 0; }

  /* ===== Roles semánticos ===== */
  .text-role--display-1 { font-family: var(--font-display); font-size: var(--display-1); font-weight: var(--weight-light); line-height: var(--leading-none); letter-spacing: var(--tracking-tight); }
  .text-role--display-2 { font-family: var(--font-display); font-size: var(--display-2); font-weight: var(--weight-regular); line-height: var(--leading-none); letter-spacing: var(--tracking-tight); }
  .text-role--heading-1 { font-family: var(--font-display); font-size: var(--heading-1); font-weight: var(--weight-regular); line-height: var(--leading-tight); letter-spacing: var(--tracking-snug); }
  .text-role--heading-2 { font-family: var(--font-display); font-size: var(--heading-2); font-weight: var(--weight-regular); line-height: var(--leading-tight); letter-spacing: var(--tracking-snug); }
  .text-role--heading-3 { font-family: var(--font-display); font-size: var(--heading-3); font-weight: var(--weight-regular); line-height: var(--leading-snug); letter-spacing: var(--tracking-snug); }
  .text-role--subheading { font-family: var(--font-subhead); font-size: var(--subheading); font-weight: var(--weight-regular); line-height: var(--leading-normal); }
  .text-role--title { font-family: var(--font-display); font-size: var(--title); font-weight: var(--weight-regular); line-height: var(--leading-snug); letter-spacing: var(--tracking-snug); }
  .text-role--body-lg { font-family: var(--font-body); font-size: var(--body-lg); font-weight: var(--weight-regular); line-height: var(--leading-relaxed); color: var(--text-secondary); }
  .text-role--body { font-family: var(--font-body); font-size: var(--body); font-weight: var(--weight-regular); line-height: var(--leading-normal); color: var(--text-secondary); }
  .text-role--body-sm { font-family: var(--font-body); font-size: var(--body-sm); font-weight: var(--weight-regular); line-height: var(--leading-normal); color: var(--text-secondary); }
  .text-role--caption { font-family: var(--font-body); font-size: var(--caption); font-weight: var(--weight-regular); line-height: var(--leading-normal); color: var(--text-tertiary); }
  .text-role--overline { font-family: var(--font-ui); font-size: var(--overline); font-weight: var(--weight-semibold); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--text-secondary); }

  /* ===== Escala numérica ===== */
  .text-size { font-family: var(--font-body); }
  .text-size--2xs { font-size: var(--text-2xs); }
  .text-size--xs { font-size: var(--text-xs); }
  .text-size--sm { font-size: var(--text-sm); }
  .text-size--base { font-size: var(--text-base); }
  .text-size--md { font-size: var(--text-md); }
  .text-size--lg { font-size: var(--text-lg); }
  .text-size--xl { font-size: var(--text-xl); }
  .text-size--2xl { font-size: var(--text-2xl); }
  .text-size--3xl { font-size: var(--text-3xl); }
  .text-size--4xl { font-size: var(--text-4xl); }
  .text-size--5xl { font-size: var(--text-5xl); }
  .text-size--6xl { font-size: var(--text-6xl); }

  /* ===== Familias ===== */
  .text--f-display { font-family: var(--font-display); }
  .text--f-body { font-family: var(--font-body); }
  .text--f-subhead { font-family: var(--font-subhead); }
  .text--f-ui { font-family: var(--font-ui); }
  .text--f-accent { font-family: var(--font-accent); }
  .text--f-mono { font-family: var(--font-mono); }

  /* ===== Pesos ===== */
  .text--w-light { font-weight: var(--weight-light); }
  .text--w-regular { font-weight: var(--weight-regular); }
  .text--w-semibold { font-weight: var(--weight-semibold); }
  .text--w-bold { font-weight: var(--weight-bold); }

  /* ===== Colores ===== */
  .text--primary { color: var(--text-primary); }
  .text--secondary { color: var(--text-secondary); }
  .text--tertiary { color: var(--text-tertiary); }
  .text--accent { color: var(--accent-default); }
  .text--disabled { color: var(--text-disabled); }

  /* ===== Tracking ===== */
  .text--tr-tight { letter-spacing: var(--tracking-tight); }
  .text--tr-snug { letter-spacing: var(--tracking-snug); }
  .text--tr-normal { letter-spacing: var(--tracking-normal); }
  .text--tr-wide { letter-spacing: var(--tracking-wide); }
  .text--tr-label { letter-spacing: var(--tracking-label); }

  /* ===== Line height ===== */
  .text--lh-none { line-height: var(--leading-none); }
  .text--lh-tight { line-height: var(--leading-tight); }
  .text--lh-snug { line-height: var(--leading-snug); }
  .text--lh-normal { line-height: var(--leading-normal); }
  .text--lh-relaxed { line-height: var(--leading-relaxed); }
</style>
