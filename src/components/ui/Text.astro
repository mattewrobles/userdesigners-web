---
interface Props {
  as?: "h1" | "h2" | "h3" | "h4" | "p" | "span" | "div";
  size?: "2xs" | "xs" | "sm" | "base" | "lg" | "xl" | "2xl" | "3xl" | "4xl" | "5xl" | "6xl" | "display" | "title";
  weight?: "400" | "500" | "600" | "700";
  color?: "primary" | "secondary" | "tertiary" | "accent" | "disabled";
  tracking?: "tight" | "normal" | "wide" | "label";
  leading?: "none" | "tight" | "snug" | "normal" | "relaxed";
}

const { as = "p", size = "base", weight = "500", color = "primary", tracking = "normal", leading = "normal" } = Astro.props;
const Tag = as;
---

<Tag class={`text text--${size} text--w-${weight} text--${color} text--tr-${tracking} text--lh-${leading}`}>
  <slot />
</Tag>

<style>
  .text { font-family: var(--font-body); }

  .text--2xs { font-size: var(--text-2xs); }
  .text--xs { font-size: var(--text-xs); }
  .text--sm { font-size: var(--text-sm); }
  .text--base { font-size: var(--text-base); }
  .text--lg { font-size: var(--text-lg); }
  .text--xl { font-size: var(--text-xl); }
  .text--2xl { font-size: var(--text-2xl); }
  .text--3xl { font-size: var(--text-3xl); }
  .text--4xl { font-size: var(--text-4xl); }
  .text--5xl { font-size: var(--text-5xl); }
  .text--6xl { font-size: var(--text-6xl); }
  .text--display { font-size: var(--text-display); font-family: var(--font-display); line-height: var(--leading-none); letter-spacing: var(--tracking-tight); }
  .text--title { font-size: var(--text-title); font-family: var(--font-display); line-height: var(--leading-snug); letter-spacing: var(--tracking-tight); }

  .text--w-400 { font-weight: 400; }
  .text--w-500 { font-weight: 500; }
  .text--w-600 { font-weight: 600; }
  .text--w-700 { font-weight: 700; }

  .text--primary { color: var(--text-primary); }
  .text--secondary { color: var(--text-secondary); }
  .text--tertiary { color: var(--text-tertiary); }
  .text--accent { color: var(--accent-default); }
  .text--disabled { color: var(--text-disabled); }

  .text--tr-tight { letter-spacing: var(--tracking-tight); }
  .text--tr-normal { letter-spacing: var(--tracking-normal); }
  .text--tr-wide { letter-spacing: var(--tracking-wide); }
  .text--tr-label { letter-spacing: var(--tracking-label); text-transform: uppercase; }

  .text--lh-none { line-height: var(--leading-none); }
  .text--lh-tight { line-height: var(--leading-tight); }
  .text--lh-snug { line-height: var(--leading-snug); }
  .text--lh-normal { line-height: var(--leading-normal); }
  .text--lh-relaxed { line-height: var(--leading-relaxed); }
</style>
