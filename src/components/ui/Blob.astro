---
interface Props {
  variant?: "1" | "2" | "3" | "hero";
  size?: number;      // ancho en px del óvalo
  blur?: number;      // blur en px (el home usa 48)
  opacity?: number;   // el home usa 0.38
  rotate?: boolean;
  speed?: number;
  top?: string;
  right?: string;
  bottom?: string;
  left?: string;
  style?: string;
}

const {
  variant = "3",
  size = 470,
  blur = 48,
  opacity = 0.38,
  rotate = true,
  speed = 30,
  top, right, bottom, left,
  style: extraStyle,
} = Astro.props;
// gradientes del home real (framer-vcgj52 Glow): linear vertical
const gradients = {
  "1": "linear-gradient(#f6c65f 0%, #e367548c 48.1%, #998dd0 100%)",
  "2": "linear-gradient(140deg, rgb(246,198,95) 0%, rgb(227,103,83) 30%, rgb(153,141,208) 79%, rgb(132,217,250) 100%)",
  "3": "linear-gradient(140deg, rgb(132,217,250) 0%, rgb(18,61,255) 45%, rgb(74,222,255) 100%)",
  "hero": "linear-gradient(#f6c65f 0%, #e367548c 48.1%, #998dd0 100%)",
};
const bg = gradients[variant] || gradients["3"];
const position = [top && `top:${top}`, right && `right:${right}`, bottom && `bottom:${bottom}`, left && `left:${left}`].filter(Boolean).join(";");
---

<div
  class="blob"
  data-rotate={rotate}
  data-speed={speed}
  style={`--blob-size:${size}px;--blob-blur:${blur}px;--blob-opacity:${opacity};--blob-bg:${bg};${position}${extraStyle ? ";" + extraStyle : ""}`}
  aria-hidden="true"
></div>

<script>
  import { animate } from "motion";

  // rota el óvalo suavemente como el Glow del home (el canvas lo anima en runtime)
  document.querySelectorAll(".blob").forEach((el, i) => {
    const rotate = el.dataset.rotate === "true";
    if (!rotate) return;
    const speed = Number(el.dataset.speed || 30);
    const reverse = i % 2 === 1;
    animate(
      el,
      { transform: ["rotate(0deg)", `rotate(${reverse ? -360 : 360}deg)`] },
      { duration: speed, repeat: Infinity, ease: "linear" }
    );
  });
</script>

<style>
  .blob {
    position: absolute;
    border-radius: 888px; /* forma de óvalo del Glow del home */
    background: var(--blob-bg);
    filter: blur(var(--blob-blur));
    -webkit-filter: blur(var(--blob-blur));
    opacity: var(--blob-opacity);
    width: var(--blob-size);
    height: calc(var(--blob-size) * 1.27); /* 470x597 como el home */
    pointer-events: none;
    z-index: 0;
    will-change: transform;
  }
</style>
