---
// Hero del home — réplica 1:1 del HTML Framer (src/html/index.html).
// Secciones: Content(Top+SocialProof) + Gradient Blur + Line + Title.
import Button from "../ui/Button.astro";
import LetterReveal from "../ui/LetterReveal.astro";
import Reveal from "../ui/Reveal.astro";
import HomeLogos from "./HomeLogos.astro";
---

<section class="hero" id="inicio">
  <!-- Glow: masa estática EXACTA del original (gradiente 140deg, blur 80, hard-light) + blobs animados sutiles encima -->
  <div class="hero-glow" aria-hidden="true">
    <div class="hero-glow-mass"></div>
    <div class="hero-glow-mass hero-glow-mass--b"></div>
  </div>

  <!-- Content -->
  <div class="hero-content">
    <div class="hero-top">
      <div class="hero-text">
        <LetterReveal as="h1" stagger={0.035} duration={0.5}>Agencia de UX/UI orientada a Fintechs</LetterReveal>
        <Reveal as="p" y={24} delay={0.15} blur={false} class="hero-sub">
          Desde la investigación hasta la escalabilidad: Somos una agencia de experiencias
          digitales guiada por datos ideal para Fintechs, Banks y Neo Banks.
        </Reveal>
        <Reveal y={18} delay={0.3} blur={false} class="hero-cta">
          <Button variant="stroke" href="/servicios">Ver servicios</Button>
        </Reveal>
      </div>

      <div class="hero-social">
        <Reveal as="p" y={16} delay={0.5} blur={false} class="hero-trust">Marcas con las que trabajamos:</Reveal>
        <Reveal y={16} delay={0.6} blur={false} class="hero-logos">
          <HomeLogos />
        </Reveal>
      </div>
    </div>
  </div>

  <!-- Line -->
  <div class="hero-line" aria-hidden="true">
    <span class="hero-line-pulse"></span>
  </div>

  <!-- Title: intro a la sección de servicios -->
  <div class="hero-title">
    <Reveal y={16} blur={false} class="hero-kicker-wrap"><p class="hero-kicker">NUESTROS SERVICIOS</p></Reveal>
    <Reveal as="h2" y={24} delay={0.1} blur={false} class="hero-h2">
      Más de 12 años en el mercado de Startups y Fintechs
    </Reveal>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    padding: clamp(120px, 15vh, 170px) 24px 0;
    overflow: clip;
  }
  .hero *, .hero *::before, .hero *::after {
    box-sizing: border-box;
  }

  /* ---------- Glow (masa original + blobs animados) ---------- */
  .hero-glow {
    filter: blur(20px);
    mix-blend-mode: screen;
    z-index: 1;
    flex: none;
    width: 59%;
    height: 60%;
    position: absolute;
    top: 20%;
    left: 0%;
    overflow: hidden;
    pointer-events: none;
  }
  .hero-glow-mass {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 48px;
    /* El gradiente es MÁS GRANDE que el elemento y se desplaza por
       background-position → el blob cambia de forma (morph), no solo se mueve */
    background-size: 220% 220%;
    background-repeat: no-repeat;
    animation:
      hero-move-a 6s ease-in-out infinite alternate,
      hero-morph-a 11s ease-in-out infinite alternate;
    will-change: transform, background-position;
  }
  .hero-glow-mass--b {
    animation:
      hero-move-b 8.5s ease-in-out infinite alternate,
      hero-morph-b 14s ease-in-out infinite alternate;
  }

  /* Movimiento independiente (péndulo suave: va y vuelve, sin saltos) */
  @keyframes hero-move-a {
    from { transform: translate(0%, 0%) scale(1); }
    to   { transform: translate(10%, -8%) scale(1.15); }
  }
  @keyframes hero-move-b {
    from { transform: translate(0%, 0%) scale(1); }
    to   { transform: translate(-12%, 10%) scale(1.18); }
  }

  /* Morph: el gradiente se desplaza dentro del área grande → la forma
     del blob se estira, encoge y deforma (como lava real), yendo y volviendo */
  @keyframes hero-morph-a {
    from { background-position: 0% 0%; }
    to   { background-position: 100% 80%; }
  }
  @keyframes hero-morph-b {
    from { background-position: 100% 100%; }
    to   { background-position: 0% 40%; }
  }
  .hero-blobs {
    position: absolute;
    inset: 0;
    z-index: 2;
  }
    pointer-events: none;
  }

  /* ---------- Content ---------- */
  .hero-content {
    width: 100%;
    max-width: 880px;
    margin: 0 auto;
    min-width: 0;
    display: block;
    position: relative;
    z-index: 2;
  }
  .hero-top {
    flex-flow: column;
    place-content: center flex-start;
    align-items: center;
    gap: 36px;
    width: 100%;
    min-width: 0;
    display: flex;
  }
  .hero-text {
    width: 100%;
    max-width: 720px;
    display: block;
    text-align: center;
  }
  .hero-text :global(h1) {
    font-family: var(--font-display);
    font-size: clamp(34px, 4.6vw, 66px);
    font-weight: 500;
    letter-spacing: -0.03em;
    text-align: center;
    color: var(--text-primary);
    line-height: 1.1;
    margin: 0 auto;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-wrap: break-word;
  }
  :global(.hero-sub) {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.7;
    text-align: center;
    color: rgba(255, 255, 255, 0.92);
    max-width: 720px;
    margin: 24px auto 0;
  }
  :global(.hero-cta) {
    display: flex;
    justify-content: center;
    margin-top: 8px;
  }

  /* Botón del hero: borde brillante tipo glass como el original Framer.
     (refuerza el glow del Button stroke dentro de este contexto) */
  :global(.hero-cta .btn--stroke) {
    background: rgba(255, 255, 255, 0.06);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.24), inset 0 1px 0 rgba(255, 255, 255, 0.38);
  }
  :global(.hero-cta .btn-stroke-glow) {
    opacity: 1;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      rgba(255, 255, 255, 0) 50deg,
      rgba(255, 255, 255, 0.85) 100deg,
      rgba(255, 255, 255, 0) 160deg
    );
  }
  :global(.hero-cta .btn-stroke-glow--2) {
    opacity: 0.75;
  }

  /* ---------- SocialProof ---------- */
  .hero-social {
    flex-flow: column;
    align-items: center;
    gap: 16px;
    width: 100%;
    max-width: 620px;
    display: flex;
  }
  :global(.hero-trust) {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
    color: #ffffff;
    margin: 0;
  }

  /* ---------- Line ---------- */
  .hero-line {
    background: linear-gradient(90deg, rgba(16, 17, 22, 0) 0%, #101116 16.2% 87.9%, rgba(16, 17, 22, 0) 100%);
    flex: none;
    width: 100%;
    max-width: 1200px;
    height: 1px;
    margin-top: 96px;
    position: relative;
    z-index: 2;
    overflow: visible;
  }
  .hero-line-pulse {
    background-color: rgba(255, 255, 255, 0.29);
    border-radius: 222px;
    flex: none;
    width: 70px;
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    animation: hero-line-run 7s cubic-bezier(0.45, 0, 0.2, 1) infinite;
  }
  @keyframes hero-line-run {
    0% { transform: translateX(0); opacity: 0.35; }
    45% { opacity: 1; }
    100% { transform: translateX(calc(min(1200px, 100vw) - 70px)); opacity: 0.35; }
  }

  /* ---------- Title (intro servicios) ---------- */
  .hero-title {
    flex-flow: column;
    align-items: center;
    gap: 24px;
    width: 100%;
    max-width: 800px;
    padding: 96px 0 80px;
    display: flex;
    position: relative;
    z-index: 2;
  }
  :global(.hero-h2) {
    font-family: var(--font-display);
    font-size: clamp(30px, 4vw, 49px);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.4em;
    text-align: center;
    color: var(--text-primary);
    margin: 0;
    text-wrap: balance;
  }
  :global(.hero-kicker) {
    font-family: var(--font-body);
    font-size: 14px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: rgb(187, 187, 187);
    margin: 0;
  }

  /* ---------- Mobile (breakpoints reales Framer) ---------- */
  @media (max-width: 809.98px) {
    .hero {
      padding: clamp(84px, 14vh, 110px) 16px 0;
    }
    .hero-content { gap: 56px; }
    .hero-text :global(h1) {
      font-size: clamp(32px, 8.6vw, 44px);
      line-height: 1.12;
      text-wrap: wrap;
      overflow-wrap: break-word;
    }
    .hero-line { margin-top: 72px; }
    .hero-line-pulse { width: 100%; }
    .hero-title { padding: 72px 0 56px; }
    .hero-blobs { opacity: 0.75; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line-pulse { animation: none; opacity: 1; }
  }
</style>

<script is:inline>
  // Gradiente del hero: 2 focos independientes, paleta y FORMA al azar por carga.
  (function () {
    const massA = document.querySelector(".hero-glow-mass:not(.hero-glow-mass--b)");
    const massB = document.querySelector(".hero-glow-mass--b");
    if (!massA || !massB) return;
    const palettes = [
      ["rgb(255,200,80)", "rgb(0,190,255)"],
      ["rgb(255,180,60)", "rgb(0,170,255)"],
      ["rgb(255,220,100)", "rgb(0,200,240)"],
      ["rgb(255,80,60)", "rgb(40,80,200)"],
      ["rgb(255,50,70)", "rgb(60,60,220)"],
      ["rgb(220,40,90)", "rgb(30,100,255)"],
      ["rgb(255,70,50)", "rgb(20,60,220)"],
      ["rgb(200,60,220)", "rgb(40,80,255)"],
      ["rgb(150,50,255)", "rgb(0,140,255)"],
    ];
    // Formas orgánicas en PORCENTAJES (escalan al tamaño real) — blob irregular,
    // ameba, hoja, cruz suave, estrella redonda, doble lóbulo.
    const shapes = [
      "polygon(28% 8%, 52% 2%, 76% 14%, 94% 38%, 90% 64%, 74% 92%, 44% 90%, 12% 78%, 6% 48%, 12% 22%)",
      "polygon(18% 14%, 52% 0%, 82% 12%, 98% 42%, 92% 66%, 80% 90%, 50% 96%, 16% 84%, 8% 56%, 10% 30%)",
      "polygon(38% 6%, 60% 10%, 74% 24%, 92% 42%, 84% 62%, 78% 88%, 52% 94%, 26% 96%, 12% 74%, 6% 44%)",
      "polygon(24% 18%, 46% 2%, 70% 14%, 92% 32%, 88% 58%, 82% 86%, 54% 92%, 28% 94%, 12% 72%, 8% 42%)",
      "polygon(50% 2%, 64% 22%, 84% 50%, 68% 58%, 72% 78%, 56% 92%, 44% 94%, 30% 78%, 16% 58%, 34% 42%)",
      "polygon(22% 8%, 56% 0%, 84% 20%, 100% 44%, 92% 66%, 82% 90%, 52% 94%, 24% 96%, 12% 70%, 4% 44%)",
    ];
    // 2 formas distintas (no repetidas) para A y B
    let ia = Math.floor(Math.random() * shapes.length);
    let ib;
    do { ib = Math.floor(Math.random() * shapes.length); } while (ib === ia);
    const [a, b] = palettes[Math.floor(Math.random() * palettes.length)];
    massA.style.background =
      "radial-gradient(60% 55% at 40% 45%, " + a + ", rgba(0,0,0,0) 68%)";
    massA.style.clipPath = shapes[ia];
    massB.style.background =
      "radial-gradient(55% 60% at 40% 45%, " + b + ", rgba(0,0,0,0) 68%)";
    massB.style.clipPath = shapes[ib];
  })();
</script>
