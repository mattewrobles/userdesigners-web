---

<footer class="site-footer">
  <div class="footer-effects">
    <div class="footer-grid">
      <div class="footer-grid-line"></div>
      <div class="footer-grid-line"></div>
      <div class="footer-grid-line"></div>
      <div class="footer-grid-line"></div>
    </div>
    <div class="footer-blur"></div>
    <div class="footer-flare">
      <svg viewBox="0 0 1156 614" style="width:100%;height:100%">
        <path d="M0 0H1156V614H0V0Z" fill="url(#g1)" opacity="0.15"/>
        <defs>
          <linearGradient id="g1" x1="578" y1="0" x2="578" y2="614" gradientUnits="userSpaceOnUse">
            <stop stop-color="#84d9fa" offset="0"/>
            <stop stop-color="#123dff" offset="0.5"/>
            <stop stop-color="#4adeff" offset="1"/>
          </linearGradient>
        </defs>
      </svg>
    </div>
  </div>

  <div class="footer-inner">
    <div class="footer-content">
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <img src="/assets/local/THPlYhmIylZZQK7C2oB2vUpYec.png" alt="UserDesigners" width="140" height="24" />
        </a>
        <p class="footer-tagline">Agencia de diseñadores UX/UI.</p>
        <a href="mailto:latam@userdesigners.com" class="footer-contact">latam@userdesigners.com</a>
        <a href="https://wa.me/593961026799" target="_blank" rel="noopener" class="footer-contact">(+593)0961026799</a>
      </div>

      <div class="footer-col">
        <h5>Nuestra Presencia</h5>
        <ul>
          <li>Ecuador</li>
          <li>México</li>
          <li>Colombia</li>
          <li>España</li>
          <li>Estados Unidos</li>
        </ul>
      </div>

      <div class="footer-col">
        <h5>Enlaces rápidos</h5>
        <ul>
          <li><a href="/proyectos">Proyectos</a></li>
          <li><a href="/servicios">Nuestros servicios</a></li>
          <li><a href="/nosotros">Conoce al team</a></li>
          <li><a href="/contacto">Contáctanos</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h5>Social Media</h5>
        <ul>
          <li><a href="https://www.instagram.com/userdesigners" target="_blank" rel="noopener">Instagram</a></li>
          <li><a href="https://www.facebook.com/userdesigners" target="_blank" rel="noopener">Facebook</a></li>
          <li><a href="https://www.linkedin.com/company/user-designers" target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2025 Userdesigners. All rights reserved.</p>
      <a href="/">Privacy policy</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: #000;
    border-top: 1px solid rgba(101, 103, 113, 0.15);
    overflow: hidden;
    font-family: "Manrope", sans-serif;
  }

  .footer-effects {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .footer-grid {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    opacity: 0.15;
  }

  .footer-grid-line {
    border-left: 1px solid rgba(101, 103, 113, 0.5);
    border-right: 1px solid rgba(101, 103, 113, 0.5);
  }

  .footer-blur {
    position: absolute;
    top: -100px;
    left: 50%;
    width: 600px;
    height: 300px;
    transform: translateX(-50%);
    background: conic-gradient(from 0deg, rgb(208, 69, 255), rgb(153, 141, 208), rgb(0, 68, 255), rgb(255, 191, 0), rgb(208, 69, 255));
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.08;
  }

  .footer-flare {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 100%;
    filter: blur(30px);
    opacity: 0.7;
  }

  .footer-inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 24px 32px;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 40px;
  }

  .footer-logo {
    display: block;
    margin-bottom: 16px;
  }
  .footer-logo img {
    display: block;
    height: 24px;
    width: auto;
    object-fit: contain;
    object-position: left center;
  }

  .footer-tagline {
    color: #fff;
    font-size: 14px;
    line-height: 1.7;
    margin: 0 0 24px;
    max-width: 280px;
  }

  .footer-contact {
    display: block;
    color: #fff;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
    margin-bottom: 10px;
    transition: opacity 0.2s;
  }
  .footer-contact:hover { opacity: 0.6; }

  .footer-col h5 {
    font-family: "Clash Grotesk", "Clash Grotesk Placeholder", sans-serif;
    font-size: 18px;
    font-weight: 500;
    color: #fff;
    margin: 0 0 20px;
    line-height: 1.4;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-col li {
    color: rgb(206, 206, 206);
    font-size: 14px;
    line-height: 1.4;
    margin-bottom: 10px;
  }

  .footer-col a {
    color: rgb(206, 206, 206);
    text-decoration: none;
    transition: color 0.2s;
    font-size: 14px;
  }
  .footer-col a:hover { color: #fff; }

  .footer-bottom {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-bottom p {
    color: rgb(206, 206, 206);
    font-size: 13px;
    margin: 0;
  }

  .footer-bottom a {
    color: rgb(206, 206, 206);
    font-size: 13px;
    text-decoration: none;
  }
  .footer-bottom a:hover { color: #fff; }

  @media (max-width: 809.98px) {
    .footer-content {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
    .footer-brand { grid-column: 1 / -1; }
    .footer-bottom { flex-direction: column; gap: 12px; text-align: center; }
    .footer-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>