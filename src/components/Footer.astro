<script>
  import { animate, spring } from "motion";

  const footer = document.getElementById("footer");
  if (footer) {
    const blurs = [
      footer.querySelector(".f-blur-1"),
      footer.querySelector(".f-blur-2"),
      footer.querySelector(".f-blur-3"),
    ];

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          blurs.forEach((el, i) => {
            if (!el) return;
            const inner = el.querySelector("[class$=-inner]");
            setTimeout(() => {
              el.style.opacity = "1";
              el.style.transform = "translate(-50%, -50%) perspective(1200px)";
              if (inner) {
                animate(inner, {
                  transform: ["scale(0.83) rotate(0deg)", "scale(0.83) rotate(360deg)"],
                }, { duration: 25, repeat: Infinity, ease: "linear" });
              }
            }, i * 150);
          });
          observer.disconnect();
        }
      });
    }, { threshold: 0.1 });

    observer.observe(footer);

    // Hover effects on footer links
    footer.querySelectorAll(".f-col-sub a, .f-contact, .f-bottom a").forEach(link => {
      link.addEventListener("mouseenter", () => {
        animate(link, { color: ["var(--text-tertiary)", "#fff"] }, { type: spring, stiffness: 300, damping: 25 });
      });
      link.addEventListener("mouseleave", () => {
        animate(link, { color: ["#fff", "var(--text-tertiary)"] }, { type: spring, stiffness: 300, damping: 25 });
      });
    });
  }
</script>

