---
const links = [
  { href: "/", label: "Inicio" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/servicios", label: "Servicios" },
  { href: "/proyectos", label: "Proyectos" },
  { href: "/contacto", label: "Contacto" },
  { href: "/blog", label: "Blog" },
];
const currentPath = Astro.url.pathname;
---

<section id="navbar">
  <div class="nav-inner" id="navInner">
    <div class="nav-wrapper">
      <a href="/" class="nav-logo">
        <img src="/assets/local/THPlYhmIylZZQK7C2oB2vUpYec.png" alt="UserDesigners" />
      </a>

      <div class="nav-list">
        {links.map(link => (
          <a href={link.href} class="nav-link">
            <span class={"nav-link-text" + (currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href)) ? " active" : "")}>{link.label}</span>
          </a>
        ))}
      </div>

      <div class="nav-cta-area">
        <a href="https://wa.me/593961026799?text=Hola%20UserDesigners%2C%20quiero%20agendar%20una%20sesi%C3%B3n" target="_blank" rel="noopener" class="nav-cta"><span>Charlemos</span></a>
      </div>

      <button class="nav-hamburger" id="navHamburger" aria-label="Menú">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobileMenu">
    <div class="mobile-links">
      {links.map((link, i) => (
        <a href={link.href} class={"mobile-link" + (currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href)) ? " active" : "")}>{link.label}</a>
      ))}
      <a href="https://wa.me/593961026799?text=Hola%20UserDesigners%2C%20quiero%20agendar%20una%20sesi%C3%B3n" target="_blank" rel="noopener" class="mobile-cta">Charlemos</a>
    </div>
  </div>
</section>

<script>
  import { animate, spring, stagger } from "motion";

  const navInner = document.getElementById("navInner");
  const hamburger = document.getElementById("navHamburger");
  const mobileMenu = document.getElementById("mobileMenu");

  if (!navInner || !hamburger || !mobileMenu) {
    console.warn("Navbar elements not found");
  } else {
    // Scroll pill animation
    let ticking = false;
    window.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          navInner.classList.toggle("scrolled", window.scrollY > 15);
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    // Appear animation on load
    try {
      animate(
        navInner,
        { opacity: [0, 1], transform: ["translateY(-30px)", "translateY(0)"] },
        { duration: 0.6, ease: spring({ stiffness: 150, damping: 20 }) }
      );
    } catch (e) { /* motion appear fallback */ }

    // Hover effects with spring - solo color
    const links = document.querySelectorAll(".nav-link-text");
    const cta = document.querySelector(".nav-cta");
    const defaultColor = "rgba(255,255,255,0.5)";
    const hoverColor = "#fff";

    links.forEach(link => {
      link.addEventListener("mouseenter", () => {
        try { animate(link, { color: [defaultColor, hoverColor] }, { type: spring, stiffness: 300, damping: 25 });
        } catch (e) { link.style.color = hoverColor; }
      });
      link.addEventListener("mouseleave", () => {
        if (!link.classList.contains("active")) {
          try { animate(link, { color: [hoverColor, defaultColor] }, { type: spring, stiffness: 300, damping: 25 });
          } catch (e) { link.style.color = defaultColor; }
        }
      });
    });

    // CTA hover
    cta?.addEventListener("mouseenter", () => {
      try { animate(cta, { background: ["rgba(255,255,255,0.08)", "rgba(255,255,255,0.14)"] }, { type: spring, stiffness: 300, damping: 25 });
      } catch (e) { cta.style.background = "rgba(255,255,255,0.14)"; }
    });
    cta?.addEventListener("mouseleave", () => {
      try { animate(cta, { background: ["rgba(255,255,255,0.14)", "rgba(255,255,255,0.08)"] }, { type: spring, stiffness: 300, damping: 25 });
      } catch (e) { cta.style.background = "rgba(255,255,255,0.08)"; }
    });

    // Hamburger toggle
    hamburger.addEventListener("click", () => {
      const isOpen = mobileMenu.classList.toggle("open");
      hamburger.classList.toggle("open");
      document.body.style.overflow = isOpen ? "hidden" : "";

      const spans = hamburger.querySelectorAll("span");
      const springOpts = { type: spring, stiffness: 400, damping: 20 };

      try {
        if (isOpen) {
          animate(spans[0], { transform: ["translateY(0)", "translateY(7px) rotate(45deg)"] }, springOpts);
          animate(spans[1], { opacity: [1, 0], transform: ["scaleX(1)", "scaleX(0)"] }, springOpts);
          animate(spans[2], { transform: ["translateY(0)", "translateY(-7px) rotate(-45deg)"] }, springOpts);
        } else {
          animate(spans[0], { transform: ["translateY(7px) rotate(45deg)", "translateY(0)"] }, springOpts);
          animate(spans[1], { opacity: [0, 1], transform: ["scaleX(0)", "scaleX(1)"] }, springOpts);
          animate(spans[2], { transform: ["translateY(-7px) rotate(-45deg)", "translateY(0)"] }, springOpts);
        }
      } catch (e) { /* fallback handled by CSS */ }

      if (isOpen) {
        const mobileLinks = mobileMenu.querySelectorAll(".mobile-link");
        const mobileCta = mobileMenu.querySelector(".mobile-cta");
        try {
          animate(
            mobileLinks,
            { opacity: [0, 1], transform: ["translateY(20px)", "translateY(0)"] },
            { delay: stagger(0.06), duration: 0.4, ease: spring({ stiffness: 200, damping: 25 }) }
          );
          animate(
            mobileCta,
            { opacity: [0, 1], transform: ["translateY(20px)", "translateY(0)"] },
            { delay: 0.35, duration: 0.4, ease: spring({ stiffness: 200, damping: 25 }) }
          );
        } catch (e) {
          mobileLinks.forEach(l => l.style.cssText = "opacity:1;transform:translateY(0)");
          if (mobileCta) mobileCta.style.cssText = "opacity:1;transform:translateY(0)";
        }
      }
    });

    // Close mobile menu on link click
    mobileMenu.querySelectorAll("a").forEach(a => {
      a.addEventListener("click", () => {
        mobileMenu.classList.remove("open");
        hamburger.classList.remove("open");
        document.body.style.overflow = "";
      });
    });
  }
</script>

<style>
  #navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2000;
    display: flex;
    justify-content: center;
    padding: 6px 24px;
    pointer-events: none;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    width: 790px;
    padding: 12px 0; /* base: contenido expandido (como en blog) */
    border-radius: 0;
    background: transparent;
    border: 1px solid transparent;
    position: relative;
    transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: auto;
    overflow: hidden;
  }

  /* AL SCROLL: el menú se comprime (padding lateral) y aparece la pill con vidrio
     esmerilado fuerte (fondo más opaco + blur alto, como el navbar del home). */
  .nav-inner.scrolled {
    width: 790px;
    padding: 8px 20px; /* contenido se comprime un poco */
    border-radius: 60px;
    background: rgba(10, 10, 12, 0.78);
    backdrop-filter: blur(90px) saturate(2);
    -webkit-backdrop-filter: blur(90px) saturate(2);
    border-color: rgba(130, 130, 130, 0.14);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .nav-wrapper {
    flex: 1 0 0;
    display: flex;
    align-items: center;
    gap: 8px;
    width: 1px;
    min-width: 0;
  }

  .nav-logo {
    flex: none;
    width: 103px;
    display: flex;
    place-content: center flex-start;
    align-items: center;
    text-decoration: none;
    overflow: hidden;
  }
  .nav-logo img {
    flex: 1 0 0;
    display: block;
    width: 1px;
    height: 40px;
    object-fit: contain;
    object-position: left center;
  }

  .nav-list {
    flex: 1 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 1px;
    min-width: 0;
  }
  .nav-link {
    cursor: pointer;
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }
  .nav-link-text {
    font-family: "Manrope", "Manrope Placeholder", sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.2;
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
    padding: 6px 10px;
    border-radius: 40px;
  }
  .nav-link:hover .nav-link-text {
    color: #fff;
  }
  .nav-link-text.active {
    color: #fff;
  }

  .nav-cta-area {
    flex: none;
    display: flex;
    align-items: center;
    width: min-content;
  }
  .nav-cta {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 24px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.08);
    border: 2px solid rgba(130, 130, 130, 0.15);
    text-decoration: none;
    transition: background 0.15s;
    flex-shrink: 0;
  }
  .nav-cta:hover {
    background: rgba(255, 255, 255, 0.14);
  }
  .nav-cta span {
    font-family: "DM Sans", "DM Sans Placeholder", sans-serif;
    font-size: 16px;
    font-weight: 500;
    color: #fff;
    white-space: nowrap;
  }

  @media (max-width: 809.98px) {
    #navbar { padding: 6px 16px; }
    .nav-list { display: none; }
    .nav-cta-area { display: none; }
    .nav-hamburger { display: flex; }
    .nav-inner { width: 100%; }
    .nav-inner.scrolled { width: 100%; }
    .nav-wrapper { width: auto; justify-content: space-between; }
  }
  @media (min-width: 810px) and (max-width: 1439.98px) {
    .nav-inner { width: 746px; }
    .nav-inner.scrolled { width: 746px; }
    .nav-link-text { padding: 6px 8px; font-size: 15px; }
    .nav-list { gap: 4px; }
    .nav-cta { height: 42px; padding: 0 18px; }
  }
  @media (min-width: 810px) {
    .nav-hamburger { display: none !important; }
    .mobile-menu { display: none !important; }
  }

  .nav-hamburger {
    flex: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    position: relative;
    z-index: 1100;
  }
  .nav-hamburger span {
    display: block;
    width: 20px;
    height: 2px;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 2px;
    transition: all 0.3s ease;
  }
  .nav-hamburger.open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-hamburger.open span:nth-child(2) {
    opacity: 0;
  }
  .nav-hamburger.open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    z-index: 1050;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }
  .mobile-menu.open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .mobile-link {
    font-family: "Manrope", "Manrope Placeholder", sans-serif;
    font-size: 24px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    padding: 8px 20px;
    transition: color 0.2s, background 0.2s;
    border-radius: 12px;
    opacity: 0;
  }
  .mobile-link.active {
    color: #fff;
  }
  .mobile-link:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
  }
  .mobile-cta {
    font-family: "DM Sans", "DM Sans Placeholder", sans-serif;
    font-size: 20px;
    font-weight: 500;
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    border: 2px solid rgba(130, 130, 130, 0.15);
    border-radius: 16px;
    padding: 12px 32px;
    text-decoration: none;
    margin-top: 16px;
    opacity: 0;
  }

</style>