---
const links = [
  { href: "/", label: "Inicio" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/servicios", label: "Servicios" },
  { href: "/proyectos", label: "Proyectos" },
  { href: "/blog", label: "Blog" },
  { href: "/contacto", label: "Contacto" },
];
const currentPath = Astro.url.pathname;
---

<section id="navbar" class="nav-section">
  <div class="nav-inner" id="navInner">
    <a href="/" class="nav-logo">
      <img src="/assets/local/THPlYhmIylZZQK7C2oB2vUpYec.png" alt="UserDesigners" width="100" height="20" />
    </a>

    <div class="nav-links">
      {links.map(link => (
        <a
          href={link.href}
          class={"nav-link" + (currentPath === link.href ? " active" : "")}
        >{link.label}</a>
      ))}
    </div>

    <a href="https://wa.me/593961026799?text=Hola%20UserDesigners%2C%20quiero%20agendar%20una%20sesi%C3%B3n" target="_blank" rel="noopener" class="nav-cta">Charlemos</a>
  </div>
</section>

<script>
  const nav = document.getElementById("navInner");
  let ticking = false;

  window.addEventListener("scroll", () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        if (window.scrollY > 40) {
          nav.classList.add("scrolled");
        } else {
          nav.classList.remove("scrolled");
        }
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });
</script>

<style>
  .nav-section {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    display: flex;
    justify-content: center;
    padding: 16px 24px 0;
    transition: padding 0.4s ease;
  }

  .nav-section.scrolled {
    padding: 12px 24px;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1200px;
    padding: 12px 0;
    border-radius: 0;
    background: transparent;
    border: none;
    transition: all 0.4s ease;
  }

  .nav-inner.scrolled {
    padding: 8px 20px;
    border-radius: 60px;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(130, 130, 130, 0.12);
    max-width: 1100px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }
  .nav-logo img {
    display: block;
    height: 20px;
    width: auto;
    object-fit: contain;
    object-position: left center;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: rgb(161, 161, 168);
    text-decoration: none;
    padding: 8px 14px;
    border-radius: 40px;
    transition: color 0.15s, background 0.15s;
    line-height: 1.4;
    white-space: nowrap;
  }
  .nav-link:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
  }
  .nav-link.active {
    color: #fff;
  }

  .nav-cta {
    font-family: "DM Sans", sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    border: 2px solid rgba(130, 130, 130, 0.15);
    border-radius: 40px;
    padding: 8px 20px;
    text-decoration: none;
    transition: background 0.15s;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .nav-cta:hover {
    background: rgba(255, 255, 255, 0.14);
  }

  @media (max-width: 809.98px) {
    .nav-section { padding: 8px 12px 0; }
    .nav-inner.scrolled { padding: 6px 12px; }
    .nav-links { display: none; }
  }

  @media (min-width: 810px) and (max-width: 1439.98px) {
    .nav-link { padding: 8px 10px; font-size: 13px; }
  }
</style>