---
import { getCollection } from "astro:content";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import BlogList from "../../components/BlogList.astro";
import BlobField from "../../components/ui/BlobField.astro";
import fs from "fs";

const allPosts = (await getCollection("blog"))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const perPage = 10;
const currentPage = 1;
const totalPages = Math.ceil(allPosts.length / perPage);
const posts = allPosts.slice(0, perPage);
const categories = [...new Set(allPosts.map(p => p.data.category).filter(Boolean))];

const framerCSS = fs.readFileSync("src/styles/framer.css", "utf-8")
  .replace(/<\/?style[^>]*>/g, "");
---

<!doctype html>
<html lang="es-EC">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Blog UX Design | Artículos sobre Diseño Digital | UserDesigners</title>
  <meta name="description" content="Artículos sobre UX Design, investigación de usuarios, design systems y producto digital para Fintechs y startups en Latinoamérica." />
  <link rel="icon" href="/assets/local/o5LtTMyVT0hoY6m1F1q3smw3kq4.png" />
  <link rel="canonical" href={new URL("/blog", Astro.site).href} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Blog | UserDesigners" />
  <meta property="og:description" content="Artículos sobre UX Design, investigación, design systems y producto digital." />
  <meta property="og:image" content={new URL("/assets/local/bUYh6jy5kjctf6KEV3vRnONhegI.png", Astro.site).href} />
  <meta property="og:url" content={new URL("/blog", Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Blog | UserDesigners" />
  <meta name="twitter:description" content="Artículos sobre UX Design, investigación, design systems y producto digital." />
  <meta name="twitter:image" content={new URL("/assets/local/bUYh6jy5kjctf6KEV3vRnONhegI.png", Astro.site).href} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": "Blog UX Design — UserDesigners",
    "description": "Artículos sobre UX Design, investigación de usuarios, design systems y producto digital.",
    "url": "https://www.userdesigners.com/blog",
    "publisher": {
      "@type": "Organization",
      "name": "UserDesigners",
      "url": "https://www.userdesigners.com"
    },
    "blogPost": allPosts.map(p => ({
      "@type": "BlogPosting",
      "headline": p.data.title,
      "description": p.data.description || p.data.title,
      "url": `https://www.userdesigners.com/blog/${p.id}`,
      "datePublished": p.data.date,
      "author": { "@type": "Organization", "name": "UserDesigners" }
    }))
  })} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;500;600&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/tokens.css" />
  <style is:global set:html={framerCSS}></style>
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-PDZVJDG9Y5"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){window.dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-PDZVJDG9Y5');
  </script>
  <!-- Microsoft Clarity -->
  <script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "xytbbmamwh");
  </script>
</head>
<body style="margin:0;background-color:#030303;color:var(--text-primary);font-family:var(--font-body);overflow-x:hidden">
  <Navbar />

  <main style="position:relative;z-index:1;padding:0">
    <section class="blog-hero" id="blogHero">
      <div class="hero-blobs" id="heroBlobs">
        <BlobField variant="blog" opacity={0.55} blur={22} />
      </div>
      <div class="hero-content">
        <div class="hero-badge">Blog</div>
        <h1 class="hero-title" id="heroTitle">
          Ideas sobre diseño<br />
          que transforman productos
        </h1>
        <p class="hero-sub" id="heroSub">
          Investigación, producto digital, design systems y todo lo que rodea al diseño centrado en el usuario.
        </p>
        <div class="hero-stats" id="heroStats">
          <div class="hero-stat">
            <span class="hero-stat-num">{allPosts.length}</span>
            <span class="hero-stat-label">artículos</span>
          </div>
          <div class="hero-stat-divider"></div>
          <div class="hero-stat">
            <span class="hero-stat-num">{categories.length}</span>
            <span class="hero-stat-label">categorías</span>
          </div>
          <div class="hero-stat-divider"></div>
          <div class="hero-stat">
            <span class="hero-stat-num">{allPosts.length > 0 ? Math.ceil(allPosts.reduce((acc, p) => acc + parseInt(p.data.readTime || "3"), 0) / allPosts.length) : 0}</span>
            <span class="hero-stat-label">min lectura promedio</span>
          </div>
        </div>
      </div>
    </section>

    <section style="max-width:1100px;margin:0 auto;padding:0 24px 120px">
      {categories.length > 0 && (
        <div style="margin-bottom:48px;display:flex;justify-content:flex-end">
          {categories.length <= 6 ? (
            <div style="display:flex;gap:8px;flex-wrap:wrap" id="blog-filters">
              {categories.map(cat => (
                <button class="blog-filter" data-filter={cat} style="all:unset;cursor:pointer;padding:6px 16px;border-radius:40px;font-size:14px;font-family:var(--font-body);color:var(--text-secondary);background:var(--surface-2);border:1px solid var(--border-subtle);transition:all 0.2s">{cat}</button>
              ))}
            </div>
          ) : (
            <select id="blog-filters" style="padding:8px 16px;border-radius:12px;background:var(--surface-2);border:1px solid var(--border-subtle);color:var(--text-primary);font-size:14px;font-family:var(--font-body);outline:none;cursor:pointer">
              <option value="all" style="background:#030303">Todas las categorías</option>
              {categories.map(cat => (
                <option value={cat} style="background:#030303">{cat}</option>
              ))}
            </select>
          )}
        </div>
      )}

      <BlogList
        posts={posts}
        currentPage={currentPage}
        totalPages={totalPages}
        baseUrl="/blog"
        categories={categories}
        totalPosts={allPosts.length}
      />
    </section>
  </main>

  <Footer />
</body>
</html>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const hero = document.getElementById("blogHero");
    const cards = document.querySelectorAll(".blog-card");
    const featured = document.querySelector("main section:nth-child(2) > a");

    if (hero) {
      const badge = hero.querySelector(".hero-badge");
      if (badge) {
        badge.classList.add("animate-in");
        badge.style.setProperty("--delay", "0.02s");
      }

      const titleEl = document.getElementById("heroTitle");
      if (titleEl) {
        const text = titleEl.innerHTML;
        const parts = text.split(/(<br\s*\/?>)/);
        let html = "";
        parts.forEach(part => {
          if (part.match(/<br\s*\/?>/)) {
            html += part;
          } else {
            const words = part.split(/(\s+)/);
            words.forEach(word => {
              if (word.trim() === "") {
                html += word;
              } else {
                html += '<span class="hero-word">';
                for (const char of word) {
                  html += `<span class="hero-letter">${char}</span>`;
                }
                html += '</span>';
              }
            });
          }
        });
        titleEl.innerHTML = html;
        const letters = titleEl.querySelectorAll(".hero-letter");
        letters.forEach((el, i) => {
          el.style.setProperty("--i", i);
          el.classList.add("animate-letter");
        });
      }

      const subEl = document.getElementById("heroSub");
      if (subEl) {
        subEl.classList.add("animate-in");
        subEl.style.setProperty("--delay", "0.15s");
      }

      const statsEl = document.getElementById("heroStats");
      if (statsEl) {
        statsEl.classList.add("animate-in");
        statsEl.style.setProperty("--delay", "0.25s");
      }
    }

    if (featured) {
      featured.classList.add("animate-in");
      featured.style.setProperty("--delay", "0.15s");
    }

    if (cards.length) {
      cards.forEach((el, i) => {
        el.classList.add("animate-in");
        el.style.setProperty("--delay", `${0.2 + i * 0.05}s`);
      });
    }

    const filterContainer = document.getElementById("blog-filters");
    const filterSelect = document.querySelector("#blog-filters select");
    const allCards = document.querySelectorAll(".blog-card, .featured-entrance");

    function applyFilter(value) {
      const active = value === "all" ? "" : value;
      allCards.forEach(card => {
        const cat = (card.dataset.category || "").toLowerCase();
        const shouldShow = !active || cat === active.toLowerCase();
        card.style.display = shouldShow ? "" : "none";
      });
    }

    if (filterContainer) {
      filterContainer.querySelectorAll(".blog-filter").forEach(btn => {
        btn.setAttribute("role", "button");
        btn.setAttribute("aria-pressed", "false");
        btn.style.cursor = "pointer";
        btn.style.transition = "all 0.2s ease";
        btn.addEventListener("click", () => {
          const value = btn.dataset.filter || "all";
          filterContainer.querySelectorAll(".blog-filter").forEach(b => {
            const isActive = b === btn;
            b.setAttribute("aria-pressed", String(isActive));
            b.style.color = isActive ? "#030303" : "var(--text-secondary)";
            b.style.background = isActive ? "#fff" : "var(--surface-2)";
            b.style.borderColor = isActive ? "#fff" : "var(--border-subtle)";
          });
          applyFilter(value);
        });
      });
      const firstBtn = filterContainer.querySelector(".blog-filter");
      if (firstBtn) {
        firstBtn.setAttribute("aria-pressed", "true");
        firstBtn.style.color = "#030303";
        firstBtn.style.background = "#fff";
        firstBtn.style.borderColor = "#fff";
      }
    }

    if (filterSelect) {
      filterSelect.style.cursor = "pointer";
      filterSelect.addEventListener("change", () => applyFilter(filterSelect.value));
    }
  });
</script>

<style is:global>
  .framer-bjhdpb { align-items: flex-start !important; }
  .framer-WOlJs .framer-bjhdpb { overflow: visible !important; }
  .framer-WOlJs.framer-v-1lvxs1p .framer-84xib0 { height: auto !important; }
  .framer-WOlJs.framer-v-1lvxs1p .framer-1m25ze8-container { width: auto !important; }
  .framer-WOlJs .framer-1d3wp7v { width: auto !important; }
  #navbar [data-framer-appear-id] { opacity: 1 !important; transform: none !important; }
  .framer-wse24v { margin-left: auto !important; margin-right: auto !important; }
  .framer-WOlJs { background-color: #030303 !important; padding-top: 0 !important; margin-left: auto !important; margin-right: auto !important; }
  .framer-WOlJs.framer-v-ib24dp { padding-top: 0 !important; }
  .blog-card:hover { border-color: var(--border-strong) !important; background: var(--surface-2) !important; }
  .blog-card:hover img { transform: scale(1.05); }
  main section:nth-child(2) > a:hover { border-color: var(--border-strong) !important; }

  .blog-hero {
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
    padding: 160px 24px 80px;
    text-align: center;
    overflow: visible;
  }
  .hero-blobs {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: visible;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }
  .hero-badge {
    display: inline-flex;
    padding: 6px 20px;
    border-radius: 40px;
    font-family: "Familjen Grotesk", sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-primary);
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    margin-bottom: 24px;
    opacity: 0;
    filter: blur(10px);
    transform: translateY(20px);
  }
  .hero-title {
    font-family: "Familjen Grotesk", sans-serif;
    font-size: clamp(40px, 7vw, 80px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--text-primary);
    margin: 0 0 24px;
    text-wrap: balance;
  }
  .hero-letter {
    display: inline-block;
    opacity: 0.001;
    filter: blur(10px);
    transform: translateY(10px);
  }
  .hero-word {
    display: inline;
    white-space: nowrap;
  }
  .hero-sub {
    color: var(--text-tertiary);
    font-size: 18px;
    max-width: 520px;
    line-height: 1.7;
    margin: 0 0 48px;
    font-family: var(--font-body);
    opacity: 0;
    filter: blur(10px);
    transform: translateY(25px);
  }
  .hero-stats {
    display: flex;
    align-items: center;
    gap: 0;
    opacity: 0;
    filter: blur(10px);
    transform: translateY(20px);
  }
  .hero-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 0 40px;
  }
  .hero-stat-num {
    font-family: "Familjen Grotesk", sans-serif;
    font-size: 32px;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .hero-stat-label {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .hero-stat-divider {
    width: 1px;
    height: 40px;
    background: var(--surface-glass);
  }
  .featured-entrance {
    opacity: 0;
    filter: blur(10px);
    transform: translateY(30px);
  }
  .blog-filter:focus-visible,
  #blog-filters select:focus-visible {
    outline: 2px solid #0099ff;
    outline-offset: 2px;
  }
  .blog-card {
    opacity: 0;
    filter: blur(10px);
    transform: translateY(30px);
  }
  @media (max-width: 640px) {
    .blog-hero { padding: 140px 20px 60px; }
    .hero-title { font-size: clamp(32px, 10vw, 48px); }
    .hero-sub { font-size: 16px; max-width: 100%; margin-bottom: 36px; }
    .hero-stat { padding: 0 20px; }
    .hero-stat-num { font-size: 24px; }
    .hero-stats { flex-wrap: wrap; justify-content: center; gap: 0; }
    .hero-stat-divider:nth-child(4) { display: none; }
  }

  @keyframes fadeInUp {
    from { opacity: 0; filter: blur(10px); transform: translateY(30px); }
    to { opacity: 1; filter: blur(0px); transform: translateY(0); }
  }
  @keyframes letterIn {
    from { opacity: 0.001; filter: blur(10px); transform: translateY(10px); }
    to { opacity: 1; filter: blur(0px); transform: translateY(0); }
  }
  .animate-in {
    animation: fadeInUp 0.6s ease-out var(--delay, 0s) both;
  }
  .hero-letter {
    animation: letterIn 0.4s ease-out calc(var(--i, 0) * 0.02s) both;
  }
</style>