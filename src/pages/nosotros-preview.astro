---
// Nosotros — 100% Astro: HTML nativo renombrado (ud-) + Navbar/Footer DS.
import fs from "fs";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

let html = fs.readFileSync("src/html/nosotros-native.html", "utf-8");

// Forzar visibilidad (estados del player) — el hero usa opacity:0 + translateY
// como estado inicial de entrada; sin player quedan invisibles. Los transforms
// de layout (translateX(-50%), scale) NO se tocan.
html = html.replace(/opacity:\s*0\.001/gi, "opacity:1");
html = html.replace(/opacity:\s*0;/gi, "opacity:1;");
html = html.replace(/opacity:0(?!\d)/gi, "opacity:1");
html = html.replace(/transform:\s*perspective\([^)]*\)\s*translateY\([^)]*\)/gi, "transform:none");
html = html.replace(/filter:\s*blur\(10px\)/gi, "filter:none");
// visibility:hidden son estados de entrada que el player animaba
html = html.replace(/visibility:\s*hidden/gi, "visibility:visible");

// Extraer el contenido (nav se reemplaza por Navbar DS; footer por Footer DS)
const bodyMatch = html.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
const body = bodyMatch ? bodyMatch[1] : html;
// El Hero es un <header> sin cierre en el export → separarlo y cerrarlo bien.
const heroStart = body.indexOf('data-ud-name="Hero"');
const firstSection = body.indexOf('<section', heroStart);
const footerStart = body.indexOf("<footer");
const heroDesde = heroStart > 0 ? body.lastIndexOf("<header", heroStart) : -1;
const heroSeccion = heroDesde >= 0 && firstSection > heroDesde
  ? body.slice(heroDesde, firstSection) + "</header>"
  : "";
// Las secciones de contenido (Metrix → Hero final) hasta antes del footer
const desde = firstSection > 0 ? firstSection : -1;
const hasta = footerStart > 0 ? footerStart : body.length;
const secciones = desde >= 0 ? body.slice(desde, hasta) : body;
// CSS de la página (los <style> del head renombrados) — necesario para el layout
const cssStyles = html.match(/<style[^>]*>[\s\S]*?<\/style>/gi) || [];
---

<html lang="es-EC">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Nosotros nativo | UserDesigners</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Familjen+Grotesk:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/tokens.css" />
    <link rel="stylesheet" href="/home.css" />
    {cssStyles.map((s) => (
      <Fragment set:html={s} />
    ))}
    <style is:inline>
      /* Los textos de la plantilla vienen en negro (0,0,0) porque el player de
         Framer les ponía color en runtime. Sobre fondo negro deben ser blancos. */
      .ud-tqfFO h1, .ud-tqfFO h2, .ud-tqfFO h3,
      .ud-tqfFO p, .ud-tqfFO li, .ud-tqfFO span,
      .ud-tqfFO .ud-text {
        color: #fff !important;
      }
      .ud-tqfFO .ud-text[style*="--ud-text-color"] {
        --ud-text-color: #fff !important;
      }
      /* Sin el player, las slides del carrusel quedan superpuestas. En desktop
         se muestra la primera slide de cada grupo. Se ocultan las duplicadas. */
      .ud-72rtr7 [class*="-container"] {
        display: block;
      }
      /* Mobile: evitar que el hero (imagen de fondo 460px) desborde. */
      @media (max-width: 809.98px) {
        .ud-tqfFO .ud-11hemup-container,
        .ud-tqfFO .ud-1bsp8da,
        .ud-tqfFO .ud-17wmq3n {
          max-width: 100vw !important;
          overflow: hidden;
        }
        .ud-tqfFO section,
        .ud-tqfFO header {
          overflow-x: hidden;
        }
      }
      /* Hero: alinear "Diseñamos" y el carrusel de palabras (Websites/Apps/...)
         en la misma línea vertical (el display:contents del ssr-variant rompe
         el align-items:center del contenedor). */
      .ud-yw7vmx {
        align-items: center !important;
      }
      .ud-yw7vmx .ud-1615yl6-container,
      .ud-yw7vmx .ud-ay2mpr {
        position: relative !important;
        top: 30px !important;
      }
      /* CTA final: el botón "Comenzar proyecto" es más angosto que su texto.
         Se amplía y se centra para que no se corte. */
      .ud-72rtr7 .ud-hTQx5.ud-jXwnL,
      .ud-72rtr7 button.ud-hTQx5 {
        min-width: 220px !important;
        width: max-content !important;
        padding: 0 24px !important;
        white-space: nowrap !important;
      }
      .ud-72rtr7 .ud-hTQx5 .ud-text,
      .ud-72rtr7 .ud-hTQx5 span,
      .ud-72rtr7 .ud-hTQx5 p {
        white-space: nowrap !important;
      }
    </style>
  </head>
  <body style="background:#030303;margin:0;overflow-x:hidden">
    <Navbar />
    <div class="ud-tqfFO ud-72rtr7 ud-pRmuk ud-fzpBA ud-V5DFL ud-WOlJs ud-87vH0" data-ud-root="" style="min-height:100vh;width:100%;max-width:1440px">
      <Fragment set:html={heroSeccion} />
      <Fragment set:html={secciones} />
    </div>
    <Footer />
    <script is:inline>
      // El player de Framer calculaba alturas en runtime (height:min-content +
      // hijos absolute colapsan sin él). Medimos el contenido real y fijamos
      // min-height en los contenedores principales para revivir el layout.
      const fixLayout = () => {
        const root = document.querySelector(".ud-tqfFO");
        if (!root) return;
        const fix = (el) => {
          for (const child of Array.from(el.children)) {
            if (child.tagName === "STYLE") continue;
            const isBlock = child.tagName === "SECTION" || child.tagName === "HEADER";
            const isCard = (child.className || "").toString().includes("-container") && child.querySelector(":scope > *");
            if (isBlock || isCard) {
              const childRect = child.getBoundingClientRect();
              const currentH = childRect.height;
              if (isBlock || currentH < 100) {
                let maxBottom = currentH;
                for (const c of child.querySelectorAll("*")) {
                  const cr = c.getBoundingClientRect();
                  if (cr.left > childRect.right + 10 || cr.right < childRect.left - 10) continue;
                  const b = cr.bottom - childRect.top;
                  if (b > maxBottom) maxBottom = b;
                }
                if (maxBottom > currentH + 20) {
                  child.style.minHeight = Math.ceil(maxBottom) + "px";
                }
              }
            }
            fix(child);
          }
        };
        fix(root);
      };
      window.addEventListener("DOMContentLoaded", fixLayout);
      window.addEventListener("load", () => setTimeout(fixLayout, 150));

      // Team carrusel: el player de Framer expandia la tarjeta al hacer hover
      // y desplazaba el track para que la activa quede grande a la izquierda.
      const initTeamHover = () => {
        const slide = document.querySelector(".ud-3d2q6t");
        if (!slide) return;
        const cards = Array.from(slide.children);
        const cardW = 124; // ancho mini
        const gap = 6;
        const set = (grande) => {
          cards.forEach((c, i) => {
            const target = i === grande ? "3 0 0px" : "1 0 0px";
            c.style.flex = target;
            c.style.transition = "flex 0.4s cubic-bezier(0.4, 0, 0.2, 1)";
          });
          // desplazar el track para que la activa quede en la posicion grande
          // (cristian grande a la izquierda, las otras a la derecha)
          const despl = grande === 0 ? 0 : -(grande * (cardW + gap));
          slide.style.transition = "transform 0.4s cubic-bezier(0.4, 0, 0.2, 1)";
          slide.style.transform = `translateX(${despl}px)`;
        };
        cards.forEach((c, i) => {
          c.addEventListener("mouseenter", () => set(i));
          c.addEventListener("mouseleave", () => set(0));
        });
      };
      window.addEventListener("DOMContentLoaded", initTeamHover);

      // El player de Framer cambiaba la clase de variante (ud-v-*) según el
      // breakpoint. Sin player, los elementos quedan con la clase desktop y el
      // CSS mobile (selectores con ud-v-1rivokt) no aplica. Lo simulamos:
      // en viewports < 810px se agrega la variante mobile al carrusel del team.
      const applyBreakpoints = () => {
        const mobile = window.innerWidth < 810;
        const teamSlide = document.querySelector(".ud-3d2q6t");
        if (teamSlide) {
          const cls = teamSlide.className;
          if (mobile && !cls.includes("ud-v-1rivokt")) {
            teamSlide.classList.add("ud-v-1rivokt");
          } else if (!mobile && cls.includes("ud-v-1rivokt")) {
            teamSlide.classList.remove("ud-v-1rivokt");
          }
        }
      };
      window.addEventListener("DOMContentLoaded", applyBreakpoints);
      window.addEventListener("resize", applyBreakpoints);
    </script>
  </body>
</html>
