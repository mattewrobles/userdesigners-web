---
// Página temporal de diagnóstico de logos.
import Marquee from "../components/ui/Marquee.astro";
const logos = [
  { src: "/assets/local/logos/banco-bogota.svg", name: "banco-bogota" },
  { src: "/assets/local/logos/toyota.svg", name: "toyota" },
  { src: "/assets/local/logos/logo-132x21.svg", name: "132x21" },
  { src: "/assets/local/logos/logo-group-1316.svg", name: "group-1316" },
  { src: "/assets/local/logos/logo-107x29.svg", name: "107x29" },
  { src: "/assets/local/logos/logo-630.svg", name: "630" },
  { src: "/assets/local/logos/logo-group-355.svg", name: "group-355" },
  { src: "/assets/local/logos/logo-241.svg", name: "241" },
  { src: "/assets/local/logos/logo-138x28.svg", name: "138x28" },
  { src: "/assets/local/logos/utransfer.png", name: "utransfer-png" },
  { src: "/assets/local/logos/logo-117x29.svg", name: "117x29" },
  { src: "/assets/local/logos/logo-banner.png", name: "banner-png" },
  { src: "/assets/local/logos/aig.svg", name: "aig" },
  { src: "/assets/local/logos/logo-blanco.png", name: "blanco-png" },
];
---
<html lang="es-EC">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Logo Diag</title>
    <style>
      html, body { background: #ddd; margin: 0; }
      .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; padding: 24px; }
      .cell { display: flex; flex-direction: column; align-items: center; gap: 8px; }
      .cell img { height: 90px; width: auto; max-width: 100%; background: #fff; padding: 16px; border-radius: 8px; }
      .cell span { color: #333; font: 12px monospace; }
    </style>
  </head>
  <body>
    <div class="grid">
      {logos.map((l) => (
        <div class="cell">
          <img src={l.src} alt={l.name} />
          <span>{l.name}</span>
        </div>
      ))}
    </div>
  </body>
</html>
