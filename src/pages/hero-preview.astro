---
// Home nativo — Hero nuevo (aprobado por Mau) + secciones del ORIGINAL framer
// inyectadas 1:1 desde src/html/home-native.html (clases ud-, imágenes locales).
import fs from "fs";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import HomeHero from "../components/home/HomeHero.astro";
import BlogSection from "../components/home/BlogSection.astro";

let html = fs.readFileSync("src/html/home-native.html", "utf-8");

// Quitar styles inline (el CSS vive en public/home.css)
html = html.replace(/<style[^>]*>[\s\S]*?<\/style>/gi, "");

// Forzar visibilidad (estados que el player de Framer animaba) — NO tocar los
// estilos de layout, solo los estados de opacidad/transform de "appear".
html = html.replace(/opacity:\s*0\.001/gi, "opacity:1");
html = html.replace(/opacity:\s*0;/gi, "opacity:1;");
html = html.replace(/opacity:0(?!\d)/gi, "opacity:1");
html = html.replace(/transform:\s*translateY\(-?\d+px\)/gi, "transform:none");
html = html.replace(/transform:\s*perspective\([^)]*\)\s*translateY\([^)]*\)/gi, "transform:none");
// Los estados de entrada del player usan translateX(±Npx) con opacity:0.
// Sin player quedan congelados y desplazan el texto (se corta en overflow:hidden).
// Solo limpiamos los que NO son layout (el centrado usa translateX(-50%)).
html = html.replace(/opacity:1;\s*transform:\s*translateX\(-?\d+px\)/gi, "opacity:1;transform:none");
html = html.replace(/will-change:transform;opacity:1;\s*transform:\s*translateX\(-?\d+px\)/gi, "will-change:transform;opacity:1;transform:none");
html = html.replace(/transform:\s*translateX\(-?\d+px\)\s*rotate\([^)]*\)/gi, "transform:none");
html = html.replace(/transform:\s*perspective\([^)]*\)\s*translateX\(-?\d+px\)\s*translateY\([^)]*\)\s*scale\([^)]*\)/gi, "transform:none");
html = html.replace(/filter:\s*blur\(10px\)/gi, "filter:none");

// Extraer las secciones del original (Product section → Bannner), excluyendo
// TODO lo anterior (hero original + scripts de Framer) y el Blog estático.
const body = html.replace(/<body[^>]*>|<\/body>/gi, "");
const productStart = body.indexOf('data-ud-name="Product section"');
const blogStart = body.indexOf('<section class="ud-o78dmu"');
// retroceder al <section completo de la Product section
const secStart = productStart > 0 ? body.lastIndexOf("<section", productStart) : -1;
const fromProduct = secStart >= 0 ? body.slice(secStart) : body;
const secciones = blogStart > 0 ? fromProduct.slice(0, blogStart - secStart) : fromProduct;---

<html lang="es-EC">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Home nativo | UserDesigners</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Familjen+Grotesk:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/tokens.css" />
    <link rel="stylesheet" href="/home.css" />
    <style>
      /* Normalizar botones del HTML original al estilo del DS Button stroke */
      .ud-tqfFO a[data-ud-name="Bottom"],
      .ud-tqfFO a[data-ud-name="Button"],
      .ud-tqfFO [data-ud-name="Bottom"] {
        color: #fff !important;
        font-family: var(--font-body) !important;
        font-size: 14px !important;
        font-weight: 500 !important;
        letter-spacing: -0.01em !important;
        text-decoration: none !important;
      }
    </style>
  </head>
  <body style="background:#030303;margin:0;overflow-x:hidden">
    <Navbar />
    <HomeHero />
    {/* El root framer (ud-tqfFO) envuelve las secciones: los selectores de
        home.css dependen de ese ancestro (.ud-tqfFO .ud-5r60op, etc.) */}
    <div class="ud-tqfFO ud-72rtr7" data-ud-root="" style="min-height:100vh;width:100%;max-width:1440px">
      <Fragment set:html={secciones} />
    </div>
    <BlogSection />
    <Footer />

    <script is:inline>
      // Marquee de logos del hero del HTML (carrusel que el player animaba)
      document.addEventListener("DOMContentLoaded", () => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const logoWrap = document.querySelector(".ud-12n3d87-container");
        if (logoWrap) {
          const track = logoWrap.querySelector("section");
          if (track && track.scrollWidth > logoWrap.clientWidth * 1.3) {
            const clone = track.cloneNode(true);
            track.appendChild(clone);
            const distance = track.scrollWidth / 2;
            let x = 0;
            const step = () => {
              x -= 0.8;
              if (x <= -distance) x = 0;
              track.style.transform = `translateX(${x}px)`;
              requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          }
        }
      });
    </script>
  </body>
</html>
