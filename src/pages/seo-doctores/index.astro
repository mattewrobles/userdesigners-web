---
const site = "https://www.userdesigners.com"
const canonical = `${site}/seo-doctores/`

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "SEO para Médicos y Clínicas",
      "provider": { "@type": "Organization", "name": "UserDesigners", "url": site },
      "description": "Posicionamiento local en Google para médicos, clínicas y especialistas en Ecuador y Latinoamérica.",
      "areaServed": ["EC","MX","CO","ES","US"],
      "serviceType": "SEO Médico"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "¿Cuánto tarda en verse resultados del SEO médico?", "acceptedAnswer": { "@type": "Answer", "text": "Los primeros resultados locales (Google Maps, perfil de Business) suelen verse en 4 a 8 semanas. El posicionamiento orgánico toma entre 3 y 6 meses dependiendo de la especialidad y la competencia local." } },
        { "@type": "Question", "name": "¿Trabajan con cualquier tipo de especialidad médica?", "acceptedAnswer": { "@type": "Answer", "text": "Sí. Hemos trabajado con ORL, dermatólogos, cirujanos plásticos, odontólogos, clínicas generales y hospitales privados en Ecuador, México y Colombia." } },
        { "@type": "Question", "name": "¿Qué incluye el diagnóstico inicial?", "acceptedAnswer": { "@type": "Answer", "text": "Revisamos presencia en Google Business, rankings actuales por especialidad y ciudad, calidad del sitio web, reseñas y consistencia NAP frente a directorios médicos como Doctoralia." } }
      ]
    },
    { "@type": "Organization", "name": "UserDesigners", "url": site },
    { "@type": "WebSite", "name": "UserDesigners", "url": site }
  ]
}
---

<!doctype html>
<html lang="es-EC">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SEO para Médicos y Clínicas | UserDesigners</title>
  <meta name="description" content="Ayudamos a clínicas y especialistas a aparecer cuando un paciente busca atención médica. SEO local, Google Business y contenido médico confiable." />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/assets/local/o5LtTMyVT0hoY6m1F1q3smw3kq4.png" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="SEO para Médicos y Clínicas | UserDesigners" />
  <meta property="og:description" content="Ayudamos a clínicas y especialistas a aparecer cuando un paciente busca atención médica. SEO local, Google Business y contenido médico confiable." />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${site}/assets/local/o5LtTMyVT0hoY6m1F1q3smw3kq4.png`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="SEO para Médicos y Clínicas | UserDesigners" />
  <meta name="twitter:description" content="Ayudamos a clínicas y especialistas a aparecer cuando un paciente busca atención médica." />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Familjen+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-PDZVJDG9Y5"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){window.dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-PDZVJDG9Y5');
  </script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #030303;
      --surface: rgba(255,255,255,0.04);
      --border: rgba(255,255,255,0.07);
      --text: #ffffff;
      --muted: rgba(255,255,255,0.5);
      --dim: rgba(255,255,255,0.3);
      --font-body: 'DM Sans', sans-serif;
      --font-display: 'Familjen Grotesk', sans-serif;
      --max: 1120px;
      --pad: clamp(20px, 5vw, 80px);
    }

    html { background: var(--bg); color: var(--text); font-family: var(--font-body); scroll-behavior: smooth; }
    body { min-height: 100vh; overflow-x: hidden; }

    body::before {
      content: '';
      position: fixed; top: 50%; left: 50%;
      width: 900px; height: 900px;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      background: conic-gradient(from 0deg, #d045ff, #998dd0, #0044ff, #ffbf00, #d045ff);
      filter: blur(140px);
      opacity: 0.1;
      pointer-events: none;
      z-index: 0;
      animation: spin 30s linear infinite;
    }
    @keyframes spin { to { transform: translate(-50%, -50%) rotate(360deg); } }

    nav {
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px var(--pad);
      background: rgba(3,3,3,0.88);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
    }
    .nav-logo img { height: 26px; width: auto; display: block; }
    .nav-links { display: flex; gap: 28px; list-style: none; }
    .nav-links a { color: var(--muted); text-decoration: none; font-size: 14px; transition: color .2s; }
    .nav-links a:hover { color: var(--text); }
    .nav-cta {
      padding: 8px 20px;
      background: rgba(255,255,255,0.08);
      border: 1px solid var(--border);
      border-radius: 12px;
      color: var(--text);
      text-decoration: none;
      font-size: 14px; font-weight: 500;
      transition: background .2s;
    }
    .nav-cta:hover { background: rgba(255,255,255,0.13); }
    @media (max-width: 680px) { .nav-links { display: none; } }

    main { position: relative; z-index: 1; }
    .inner { max-width: var(--max); margin: 0 auto; padding: 0 var(--pad); }
    section { padding: 96px var(--pad); max-width: var(--max); margin: 0 auto; }
    hr { border: none; border-top: 1px solid var(--border); }

    .label {
      display: inline-block;
      font-size: 11px; font-weight: 600;
      letter-spacing: .12em; text-transform: uppercase;
      color: var(--dim); margin-bottom: 28px;
    }

    /* HERO */
    .hero { padding-top: 120px; padding-bottom: 80px; }
    .hero h1 {
      font-family: var(--font-display);
      font-size: clamp(36px, 6vw, 68px);
      font-weight: 500; line-height: 1.1;
      letter-spacing: -0.03em;
      max-width: 820px; margin-bottom: 24px;
    }
    .hero p {
      font-size: clamp(16px, 2vw, 19px);
      color: var(--muted); max-width: 560px;
      line-height: 1.7; margin-bottom: 36px;
    }
    .tags { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 40px; }
    .tag {
      font-size: 13px; color: var(--dim);
      border: 1px solid var(--border);
      border-radius: 20px; padding: 4px 14px;
    }
    .btn-primary {
      display: inline-block; padding: 14px 28px;
      background: var(--text); color: var(--bg);
      border-radius: 14px; font-weight: 600; font-size: 15px;
      text-decoration: none; margin-right: 12px; margin-bottom: 12px;
      transition: opacity .2s;
    }
    .btn-primary:hover { opacity: .85; }
    .btn-ghost {
      display: inline-block; padding: 14px 28px;
      border: 1px solid var(--border); border-radius: 14px;
      color: var(--muted); font-size: 15px; text-decoration: none;
      margin-bottom: 12px;
      transition: color .2s, border-color .2s;
    }
    .btn-ghost:hover { color: var(--text); border-color: rgba(255,255,255,0.2); }

    h2.section-title {
      font-family: var(--font-display);
      font-size: clamp(26px, 4vw, 46px);
      font-weight: 500; line-height: 1.15;
      letter-spacing: -0.025em;
      max-width: 700px; margin-bottom: 20px;
    }
    .section-desc { font-size: 16px; color: var(--muted); max-width: 540px; line-height: 1.7; margin-bottom: 48px; }

    .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; }
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px; padding: 26px;
    }
    .card .card-label { font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--dim); margin-bottom: 10px; }
    .card h3 { font-size: 15px; font-weight: 600; margin-bottom: 8px; }
    .card p { font-size: 14px; color: var(--muted); line-height: 1.6; }

    .client-list { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 36px; }
    .pill {
      padding: 7px 16px;
      border: 1px solid var(--border);
      border-radius: 20px;
      font-size: 14px; color: var(--muted);
    }

    .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin-bottom: 48px; }
    .step { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 26px; }
    .step-num { font-family: var(--font-display); font-size: 30px; font-weight: 600; color: var(--dim); margin-bottom: 14px; }
    .step p { font-size: 14px; color: var(--muted); line-height: 1.6; }

    .stats { display: flex; gap: 40px; flex-wrap: wrap; }
    .stat .num { font-family: var(--font-display); font-size: 34px; font-weight: 600; }
    .stat .desc { font-size: 13px; color: var(--muted); margin-top: 4px; }

    .cta-final { text-align: center; padding-top: 80px; padding-bottom: 120px; }
    .cta-final h2 {
      font-family: var(--font-display);
      font-size: clamp(28px, 4vw, 52px);
      font-weight: 500; letter-spacing: -0.025em;
      max-width: 680px; margin: 0 auto 24px; line-height: 1.15;
    }
    .cta-final p { font-size: 16px; color: var(--muted); max-width: 480px; margin: 0 auto 40px; line-height: 1.7; }

    footer {
      position: relative; z-index: 1;
      border-top: 1px solid var(--border);
      max-width: var(--max); margin: 0 auto;
      padding: 52px var(--pad);
      display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 36px;
    }
    .footer-brand p { font-size: 13px; color: var(--dim); margin-top: 8px; }
    .footer-brand a { color: var(--muted); text-decoration: none; font-size: 14px; display: block; margin-top: 4px; }
    .footer-links { display: flex; gap: 48px; flex-wrap: wrap; }
    .footer-col h4 { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--dim); margin-bottom: 12px; }
    .footer-col a { display: block; font-size: 14px; color: var(--muted); text-decoration: none; margin-bottom: 8px; transition: color .2s; }
    .footer-col a:hover { color: var(--text); }
    .footer-bottom {
      border-top: 1px solid var(--border);
      padding: 20px var(--pad); text-align: center;
      font-size: 12px; color: var(--dim);
      position: relative; z-index: 1;
    }
  </style>
</head>
<body>

<nav>
  <a class="nav-logo" href="/"><img src="/assets/local/THPlYhmIylZZQK7C2oB2vUpYec.png" alt="UserDesigners" height="26" /></a>
  <ul class="nav-links">
    <li><a href="/">Inicio</a></li>
    <li><a href="/nosotros">Nosotros</a></li>
    <li><a href="/servicios">Servicios</a></li>
    <li><a href="/proyectos">Proyectos</a></li>
    <li><a href="/blog">Blog</a></li>
    <li><a href="/contacto">Contacto</a></li>
  </ul>
  <a class="nav-cta" href="https://wa.me/593961026799" target="_blank" rel="noopener">Charlemos</a>
</nav>

<main>

  <section class="hero">
    <span class="label">SEO Médico y Posicionamiento Local</span>
    <h1>SEO para doctores que convierte búsquedas en pacientes</h1>
    <p>Ayudamos a clínicas, consultorios y especialistas a aparecer cuando un paciente busca atención médica cerca de él: Google, mapas, contenidos confiables y una estrategia pensada para generar citas.</p>
    <div class="tags">
      <span class="tag">SEO local para consultas reales</span>
      <span class="tag">Contenido confiable y ético</span>
      <span class="tag">Métricas de visibilidad y citas</span>
    </div>
    <a class="btn-primary" href="https://wa.me/593961026799" target="_blank" rel="noopener">Solicitar diagnóstico</a>
    <a class="btn-ghost" href="#enfoque">Ver enfoque</a>
  </section>

  <hr />

  <section id="enfoque">
    <span class="label">Posicionamiento para pacientes con intención</span>
    <h2 class="section-title">No se trata de tener más visitas. Se trata de aparecer cuando alguien necesita atenderse.</h2>
    <p class="section-desc">Para un doctor, una búsqueda como "dermatólogo cerca de mí" o "odontólogo en Cuenca" no es tráfico genérico: es una oportunidad de cita. Construimos la estrategia alrededor de esas búsquedas de alta intención.</p>
    <div class="card-grid">
      <div class="card">
        <h3>Búsquedas con urgencia</h3>
        <p>Capturamos pacientes que ya están comparando especialistas, ubicación, horarios y reseñas.</p>
      </div>
      <div class="card">
        <h3>Presencia en mapas</h3>
        <p>Optimizamos el perfil, categorías, servicios, fotos, publicaciones y señales locales.</p>
      </div>
      <div class="card">
        <h3>Confianza antes de la cita</h3>
        <p>Ordenamos contenido, autoridad y reputación para que la decisión se sienta segura.</p>
      </div>
    </div>
  </section>

  <hr />

  <section>
    <span class="label">Lo que trabajamos para posicionar tu consulta</span>
    <h2 class="section-title">Una estrategia completa conecta tu especialidad, tu ciudad y la confianza que un paciente necesita.</h2>
    <p class="section-desc">Cuatro áreas de trabajo coordinadas para que el SEO se conecte con agenda, llamadas y formularios.</p>
    <div class="card-grid">
      <div class="card">
        <h3>SEO local y Google Business</h3>
        <p>Especialidad, ubicación, servicios, horarios, reseñas y señales locales para aparecer donde el paciente decide.</p>
      </div>
      <div class="card">
        <h3>Contenido por especialidad</h3>
        <p>Páginas de tratamientos, síntomas, preguntas frecuentes y guías que responden con claridad sin sonar genéricas.</p>
      </div>
      <div class="card">
        <h3>Base técnica y conversión</h3>
        <p>Velocidad, estructura, indexación, arquitectura y llamadas a contacto pensadas para pasar de búsqueda a cita.</p>
      </div>
      <div class="card">
        <h3>Autoridad y reputación</h3>
        <p>Mejoramos señales de confianza: perfiles, reseñas, menciones, enlaces locales y consistencia de marca médica.</p>
      </div>
    </div>
  </section>

  <hr />

  <section>
    <span class="label">Doctores, clínicas y nuevas formas de búsqueda</span>
    <h2 class="section-title">Clientes que ya entienden que el posicionamiento médico va más allá de Google</h2>
    <p class="section-desc">Trabajamos visibilidad para búsquedas locales, respuestas directas, resultados impulsados por IA y consultas donde el paciente espera una recomendación clara antes de agendar.</p>
    <div class="client-list">
      <span class="pill">Dr. Pablo Salamea</span>
      <span class="pill">Dr. Diego Chango</span>
      <span class="pill">Dra. Lorena Villa</span>
      <span class="pill">Dr. Deniss Calderón</span>
      <span class="pill">Dr. Juan Carlos Peralvo</span>
      <span class="pill">Clínica Alelí</span>
      <span class="pill">Hospital del Río</span>
      <span class="pill">Dr. Luis Flores</span>
      <span class="pill">Gabriela Machado</span>
      <span class="pill">Y más…</span>
    </div>
    <div class="card-grid" style="margin-top:32px">
      <div class="card">
        <div class="card-label">GEO — Generative Engine Optimization</div>
        <h3>También posicionamos en IA</h3>
        <p>Optimización para que tu marca médica sea entendida, citada o recomendada por motores generativos e inteligencia artificial.</p>
      </div>
      <div class="card">
        <div class="card-label">AEO — Answer Engine Optimization</div>
        <h3>Respuestas directas donde el paciente pregunta</h3>
        <p>Fragmentos destacados, búsquedas por voz y consultas tipo "cuál doctor elegir" en Google y asistentes de IA.</p>
      </div>
    </div>
  </section>

  <hr />

  <section>
    <span class="label">Un método claro para escalar la visibilidad médica</span>
    <h2 class="section-title">Cuatro fases, resultados medibles</h2>
    <p class="section-desc">No perseguimos volumen vacío. Priorizamos términos con intención clínica, presencia local y rutas claras de contacto.</p>
    <div class="steps">
      <div class="step">
        <div class="step-num">01</div>
        <p>Diagnóstico de búsquedas, competencia, perfil de Google y oportunidades por especialidad.</p>
      </div>
      <div class="step">
        <div class="step-num">02</div>
        <p>Arquitectura de páginas, prioridades locales y plan de contenido para atraer pacientes adecuados.</p>
      </div>
      <div class="step">
        <div class="step-num">03</div>
        <p>Optimización técnica, contenidos, mapas, fichas de servicio y elementos de contacto medibles.</p>
      </div>
      <div class="step">
        <div class="step-num">04</div>
        <p>Seguimiento de rankings, tráfico cualificado, llamadas, formularios y crecimiento por ciudad o tratamiento.</p>
      </div>
    </div>
    <div class="stats">
      <div class="stat">
        <span class="num">+120</span>
        <span class="desc">keywords locales priorizadas</span>
      </div>
      <div class="stat">
        <span class="num">24/7</span>
        <span class="desc">captación desde búsquedas activas</span>
      </div>
    </div>
  </section>

  <hr />

  <section class="cta-final">
    <h2>Veamos qué búsquedas deberían encontrarte primero</h2>
    <p>Solicita un diagnóstico y revisamos tu presencia actual, tus oportunidades por especialidad y las mejoras que pueden conectar tu posicionamiento con más citas.</p>
    <a class="btn-primary" href="https://wa.me/593961026799" target="_blank" rel="noopener">Hablar sobre SEO médico</a>
  </section>

</main>

<footer>
  <div class="footer-brand">
    <img src="/assets/local/THPlYhmIylZZQK7C2oB2vUpYec.png" alt="UserDesigners" height="24" />
    <p>Agencia de diseñadores UX/UI.</p>
    <a href="mailto:latam@userdesigners.com">latam@userdesigners.com</a>
    <a href="tel:+593961026799">(+593) 0961026799</a>
