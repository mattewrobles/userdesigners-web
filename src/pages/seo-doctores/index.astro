      <a href="https://linkedin.com/company/userdesigners" target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </div>
</footer>
<div class="footer-bottom">© 2025 Userdesigners. All rights reserved.</div>

</body>
</html>
