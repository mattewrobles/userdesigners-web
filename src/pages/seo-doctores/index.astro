<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(ScrollTrigger, SplitText);

  document.addEventListener("DOMContentLoaded", () => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) return;

    // ============ HERO — timeline con scrub bidireccional ============
    // Al bajar: el H1 explota letra por letra hacia arriba y el resto se desvanece.
    // Al subir: retrocede exactamente (línea de tiempo que avanza y revierte).
    const title = document.querySelector("[data-gsap='hero-title']");
    const heroSub = document.querySelector("[data-gsap='hero-sub']");
    const heroActions = document.querySelector("[data-gsap='hero-actions']");
    const heroStats = document.querySelector("[data-gsap='hero-stats']");

    if (title) {
      // SplitText por LETRAS dentro de líneas block (.h1-line):
      // las líneas ya son bloques fijos → SplitText solo divide letras, nunca palabras
      const split = SplitText.create(title, { type: "chars" });
      const chars = split.chars;

      // 1) ENTRADA al cargar: solo desplazamiento + rotación (NUNCA toca opacity final,
      //    y sin filter blur — el blur en 47 chars cuesta FPS; y+rotation basta para el reveal)
      gsap.from(chars, {
        y: 36, rotationX: -24,
        duration: 1, ease: "power4.out", stagger: 0.02,
        onComplete: () => gsap.set(chars, { clearProps: "rotationX" })
      });

      // 2) TIMELINE DE SCROLL — fromTo con estado 0 = visible (retorna al subir)
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: ".hero",
          start: "top top",
          end: "+=170%",
          scrub: 1,
          pin: true,
          anticipatePin: 1
        }
      });

      // letras explotan hacia arriba (gravedad invertida), staggered desde el centro
      tl.fromTo(chars,
        { opacity: 1, y: 0, rotation: 0 },
        {
          opacity: 0,
          y: () => gsap.utils.random(-260, -160),
          x: () => gsap.utils.random(-40, 40),
          rotation: () => gsap.utils.random(-14, 14),
          ease: "power2.in",
          stagger: { each: 0.03, from: "center" }
        }, 0)
        // sub + CTAs + stats se desvanecen y bajan
        .fromTo([heroSub, heroActions, heroStats],
          { opacity: 1, y: 0 },
          { opacity: 0, y: -30, ease: "power2.in" }, 0)
        // el glow baja con RETRASO y más LENTO, sincronizado con la explosión de las
        // letras: empieza a bajar cuando las letras del centro ya se dispersaron (0.55)
        // y termina de moverse justo cuando la ÚLTIMA letra sale de escena (1.0).
        .fromTo(".hero-glow",
          { yPercent: 0, xPercent: -50, y: "-50%", scale: 1 },
          { yPercent: 58, xPercent: -50, y: "-50%", scale: 1.12, ease: "none", duration: 0.45 }, 0.55);
    }

    // HERO SCROLL INDICATOR — se desvanece apenas empieza el scroll
    const heroScroll = document.querySelector("[data-gsap='hero-scroll']");
    if (heroScroll) {
      gsap.to(heroScroll, {
        autoAlpha: 0, y: 12, ease: "none",
        scrollTrigger: { trigger: ".hero", start: "top top", end: "8% top", scrub: 1 }
      });
    }

    // IMÁGENES DE SECCIÓN — parallax
    gsap.utils.toArray("[data-gsap='parallax-img']").forEach(img => {
      gsap.fromTo(img, { y: -40 }, {
        y: 40, ease: "none",
        scrollTrigger: { trigger: img, start: "top bottom", end: "bottom top", scrub: 1.2 }
      });
    });

    // BENTO GEO/AEO — entrada escalonada con lift (transform puro, nunca oculta)
    const bentoCards = gsap.utils.toArray("[data-bento] .geo-card");
    if (bentoCards.length) {
      gsap.from(bentoCards, {
        y: 30, duration: 0.7, ease: "power3.out", stagger: 0.09,
        immediateRender: false,
        scrollTrigger: { trigger: "[data-bento]", start: "top 88%", once: true }
      });
    }

    // 4 FASES — entrada escalonada + parallax sutil + TILT 3D al cursor
    const stackEl = document.querySelector("[data-steps]");
    if (stackEl) {
      const stackCards = gsap.utils.toArray(stackEl.querySelectorAll(".phase-card"));

      // entrada: cada card sube desde abajo en cascada (transform puro, nunca oculta)
      gsap.from(stackCards, {
        y: 36, duration: 0.7, ease: "power3.out", stagger: 0.1,
        immediateRender: false,
        scrollTrigger: { trigger: stackEl, start: "top 85%", once: true }
      });

      // parallax sutil: desfase en capas al scrollear (±8px, no rompe alineación)
      const speeds = [1, -0.5, 0.5, -1];
      stackCards.forEach((card, i) => {
        gsap.fromTo(card,
          { y: -8 * speeds[i] },
          {
            y: 8 * speeds[i], ease: "none",
            immediateRender: false,
            scrollTrigger: {
              trigger: stackEl,
              start: "top bottom",
              end: "bottom top",
              scrub: 1.2
            }
          }
        );
      });

      // TILT 3D: la card rota siguiendo el cursor (profundidad, solo en dispositivos con pointer fino)
      if (stackCards.length && !window.matchMedia("(pointer: coarse)").matches) {
        stackCards.forEach((card) => {
          const rx = gsap.quickTo(card, "rotationX", { duration: 0.5, ease: "power3.out" });
          const ry = gsap.quickTo(card, "rotationY", { duration: 0.5, ease: "power3.out" });
          card.style.transformStyle = "preserve-3d";
          card.addEventListener("pointermove", (e) => {
            const r = card.getBoundingClientRect();
            const nx = (e.clientY - r.top - r.height / 2) / (r.height / 2); // -1..1
            const ny = (e.clientX - r.left - r.width / 2) / (r.width / 2);
            rx(nx * -6); // pitch
            ry(ny * 7);  // yaw
          });
          card.addEventListener("pointerleave", () => { rx(0); ry(0); });
        });
      }
    }

    // SCROLL HORIZONTAL — servicios (pin + scrub)
    const track = document.querySelector("[data-gsap='sh-track']");
    if (track) {
      // TÍTULO del horizontal — explosión de letras (scatter 3D) al entrar
      const shTitle = document.querySelector(".sh-header .section-title");
      if (shTitle) {
        const split = SplitText.create(shTitle, { type: "chars", mask: "chars" });
        gsap.from(split.chars, {
          y: 60, rotationX: -90, autoAlpha: 0, scale: 0.6, duration: 0.9,
          ease: "back.out(1.7)", stagger: 0.03,
          scrollTrigger: { trigger: ".sh-header", start: "top 85%" },
          onComplete: () => split.revert()
        });
      }

      const getDistance = () => track.scrollWidth - window.innerWidth;
      const tween = gsap.to(track, {
        x: () => -getDistance(),
        ease: "none",
        scrollTrigger: {
          trigger: ".services-horizontal",
          start: "top top",
          end: () => "+=" + getDistance(),
          pin: true,
          scrub: 1,
          invalidateOnRefresh: true,
          anticipatePin: 1
        }
      });
      // PANELES — se despliegan apilados (rotación 3D + stagger) al iniciar
      gsap.from(".sh-panel", {
        rotationY: -18, opacity: 0, x: 60, duration: 0.8, ease: "power3.out",
        stagger: 0.15,
        immediateRender: false,
        scrollTrigger: { trigger: ".services-horizontal", start: "top 90%" }
      });
      // cleanup en resize
      ScrollTrigger.addEventListener("refreshInit", () => tween.invalidate());
    }

    // SECTION TITLES — motion sutil de transform (NUNCA ocultan: el texto ya está visible
    // al cargar, no se re-anima "montado" con el scroll)
    gsap.utils.toArray(".section-title").forEach(h => {
      if (h.closest(".sh-header")) return; // el horizontal tiene su propia explosión de chars
      gsap.fromTo(h,
        { y: 18 },
        {
          y: 0, duration: 0.8, ease: "power3.out",
          immediateRender: false,
          scrollTrigger: { trigger: h, start: "top 85%", once: true }
        }
      );
    });

    // CARDS — motion de transform puro (sin opacity 0 → no se ocultan nunca)
    gsap.utils.toArray("[data-gsap='reveal']").forEach(el => {
      gsap.fromTo(el,
        { y: 26 },
        {
          y: 0, duration: 0.7, ease: "power3.out",
          immediateRender: false,
          scrollTrigger: { trigger: el, start: "top 90%", once: true }
        }
      );
    });

    // CTA FINAL — motion de transform puro
    const cta = document.querySelector(".cta-final");
    if (cta) {
      gsap.fromTo(cta,
        { y: 24 },
        {
          y: 0, duration: 0.8, ease: "power3.out",
          immediateRender: false,
          scrollTrigger: { trigger: cta, start: "top 85%", once: true }
        }
      );
    }
  });
</script>

