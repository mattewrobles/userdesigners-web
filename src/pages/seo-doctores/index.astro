    <div class="footer-col">
      <h4>Presencia</h4>
      <span style="font-size:14px;color:var(--muted)">Ecuador · México · Colombia · España · EE.UU.</span>
    </div>
    <div class="footer-col">
      <h4>Enlaces rápidos</h4>
      <a href="/proyectos">Proyectos</a>
      <a href="/servicios">Servicios</a>
