---
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Button from "../../components/ui/Button.astro";
import Card from "../../components/ui/Card.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";
import BlobField from "../../components/ui/BlobField.astro";
import Marquee from "../../components/ui/Marquee.astro";

const site = "https://www.userdesigners.com"
const canonical = `${site}/seo-doctores/`

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "SEO para Médicos y Clínicas",
      "provider": { "@type": "Organization", "name": "UserDesigners", "url": site },
      "description": "Posicionamiento local en Google para médicos, clínicas y especialistas en Ecuador y Latinoamérica.",
      "areaServed": ["EC","MX","CO","ES","US"],
      "serviceType": "SEO Médico"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "¿Cuánto tarda en verse resultados del SEO médico?", "acceptedAnswer": { "@type": "Answer", "text": "Los primeros resultados locales (Google Maps, perfil de Business) suelen verse en 4 a 8 semanas. El posicionamiento orgánico toma entre 3 y 6 meses dependiendo de la especialidad y la competencia local." } },
        { "@type": "Question", "name": "¿Trabajan con cualquier tipo de especialidad médica?", "acceptedAnswer": { "@type": "Answer", "text": "Sí. Hemos trabajado con ORL, dermatólogos, cirujanos plásticos, odontólogos, clínicas generales y hospitales privados en Ecuador, México y Colombia." } },
        { "@type": "Question", "name": "¿Qué incluye el diagnóstico inicial?", "acceptedAnswer": { "@type": "Answer", "text": "Revisamos presencia en Google Business, rankings actuales por especialidad y ciudad, calidad del sitio web, reseñas y consistencia NAP frente a directorios médicos como Doctoralia." } }
      ]
    },
    { "@type": "Organization", "name": "UserDesigners", "url": site },
    { "@type": "WebSite", "name": "UserDesigners", "url": site }
  ]
}
---

<!doctype html>
<html lang="es-EC">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SEO para Médicos y Clínicas | UserDesigners</title>
  <meta name="description" content="Ayudamos a clínicas y especialistas a aparecer cuando un paciente busca atención médica. SEO local, Google Business y contenido médico confiable." />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/assets/local/o5LtTMyVT0hoY6m1F1q3smw3kq4.png" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="SEO para Médicos y Clínicas | UserDesigners" />
  <meta property="og:description" content="Ayudamos a clínicas y especialistas a aparecer cuando un paciente busca atención médica. SEO local, Google Business y contenido médico confiable." />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${site}/assets/local/bUYh6jy5kjctf6KEV3vRnONhegI.png`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="SEO para Médicos y Clínicas | UserDesigners" />
  <meta name="twitter:description" content="Ayudamos a clínicas y especialistas a aparecer cuando un paciente busca atención médica." />
  <meta name="twitter:image" content={`${site}/assets/local/bUYh6jy5kjctf6KEV3vRnONhegI.png`} />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Familjen+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-PDZVJDG9Y5"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){window.dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-PDZVJDG9Y5');
  </script>
  <link rel="stylesheet" href="/styles/tokens.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html {
      background: var(--color-bg);
      color: var(--color-text);
      font-family: var(--font-body);
      scroll-behavior: smooth;
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
    }
    body { min-height: 100vh; overflow-x: hidden; }

    main { position: relative; z-index: 1; }
    section { padding: var(--space-section) var(--space-pad); max-width: var(--container-max); margin: 0 auto; }
    hr { border: none; border-top: 1px solid var(--color-border); }

    /* HERO */
    .hero { padding-top: 140px; padding-bottom: 90px; }
    .hero { position: relative; }
    .hero-blobs { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
    .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: center; }
    /* Secciones divididas texto + imagen */
    .section-split { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
    .section-split--rev { grid-template-columns: 1fr 1fr; }
    .split-cards { display: flex; flex-direction: column; gap: 16px; }
    .section-split-visual { position: relative; border-radius: var(--radius-xl); overflow: hidden; aspect-ratio: 4/3; margin-top: 8px; }
    .section-split-visual img { width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius-xl); will-change: transform; }
    .img-frame-glow { position: absolute; inset: 0; border-radius: var(--radius-xl); pointer-events: none;
      box-shadow: inset 0 0 60px rgba(3, 3, 3, 0.35); border: 1px solid var(--border-strong); }
    @media (max-width: 900px) {
      .section-split, .section-split--rev { grid-template-columns: 1fr; gap: 32px; }
      .section-split--rev .split-cards { order: 2; }
      .section-split--rev .split-text { order: 1; }
      .section-split-visual { aspect-ratio: 16/10; }
    }
    /* SECCIÓN HORIZONTAL — servicios */
    .services-horizontal { max-width: none; width: 100vw; padding: 80px 0; overflow: hidden; }
    /* MARQUEE de clientes */
    .clients-marquee { margin: 40px 0; padding: 8px 0; border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); }
    .mq-item { display: inline-flex; align-items: center; gap: 12px; font-family: var(--font-display); font-size: clamp(20px, 2.2vw, 30px); font-weight: 500; letter-spacing: -0.02em; color: var(--text-secondary); white-space: nowrap; }
    .mq-item::after { content: "✦"; font-size: 14px; color: var(--accent-default); opacity: 0.6; }
    .sh-header { max-width: var(--container-max); margin: 0 auto; padding: 0 var(--space-pad) 48px; }
    .sh-track { display: flex; gap: 0; width: max-content; padding: 0 4vw; will-change: transform; perspective: 1200px; }
    .sh-panel { flex: 0 0 34vw; min-width: 380px; margin-right: 3vw; padding: 40px 44px; border-radius: var(--radius-xl);
      border: 1px solid var(--border-strong); background: linear-gradient(180deg, var(--surface-2) 0%, var(--surface-3) 100%);
      display: flex; flex-direction: column; gap: 18px; transform-style: preserve-3d; }
    .sh-panel:hover { border-color: var(--accent-muted); }
    .sh-num { font-family: var(--font-display); font-size: 48px; font-weight: 600; color: var(--text-tertiary); letter-spacing: -0.03em; }
    .sh-panel h3 { font-family: var(--font-display); font-size: clamp(22px, 2.4vw, 32px); font-weight: 500; letter-spacing: -0.02em; color: var(--text-primary); margin: 0; }
    .sh-panel p { font-size: 16px; color: var(--text-secondary); line-height: 1.7; margin: 0; max-width: 420px; }
    .sh-img { border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 16/9; margin-top: auto; }
    .sh-img img { width: 100%; height: 100%; object-fit: cover; }
    @media (max-width: 900px) {
      .sh-panel { flex: 0 0 82vw; min-width: 0; }
    }
    .hero-content h1 { margin-bottom: 20px; }
    .hero-content p { margin-bottom: 32px; }
    .hero-visual { position: relative; border-radius: var(--radius-xl); overflow: hidden; aspect-ratio: 4/3; }
    .hero-visual img { width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius-xl); }
    .hero-visual-glow { position: absolute; inset: 0; border-radius: var(--radius-xl); pointer-events: none;
      box-shadow: inset 0 0 80px rgba(3, 3, 3, 0.4); border: 1px solid var(--border-strong); }
    .hero-visual-badge { position: absolute; left: 18px; bottom: 18px; display: inline-flex; align-items: center; gap: 10px;
      background: rgba(3, 3, 3, 0.75); backdrop-filter: blur(10px); border: 1px solid var(--border-strong);
      border-radius: 999px; padding: 10px 18px; font-size: 13px; font-weight: 500; font-family: var(--font-body); color: var(--text-primary);
      box-shadow: 0 8px 24px rgba(0,0,0,0.35); }
    .hvb-dot { width: 9px; height: 9px; border-radius: 50%; background: #4ade80; flex-shrink: 0; }
    @media (max-width: 900px) {
      .hero-grid { grid-template-columns: 1fr; gap: 28px; }
      .hero-visual { aspect-ratio: 16/10; }
    }
    .hero h1 {
      font-family: var(--font-display);
      font-size: var(--text-display);
      font-weight: 500;
      line-height: 1.05;
      letter-spacing: -0.03em;
      max-width: 900px;
      margin-bottom: 28px;
    }
    .hero p {
      font-size: clamp(16px, 2vw, 19px);
      color: var(--color-muted);
      max-width: 580px;
      line-height: 1.75;
      margin-bottom: 40px;
    }
    .hero .actions { display: flex; gap: 12px; flex-wrap: wrap; }

    h2.section-title {
      font-family: var(--font-display);
      font-size: var(--text-title);
      font-weight: 500;
      line-height: 1.12;
      letter-spacing: -0.025em;
      max-width: 720px;
      margin-bottom: 20px;
    }
    .section-desc { font-size: var(--text-base); color: var(--color-muted); max-width: 560px; line-height: 1.75; margin-bottom: 52px; }

    .card h3 { font-size: var(--text-base); font-weight: 600; margin-bottom: 8px; }
    .card p { font-size: var(--text-sm); color: var(--color-muted); line-height: 1.65; }
    .card-label { font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-muted); margin-bottom: 10px; }
    /* Cards con acento de color (marca UserDesigners) */
    .card { background: var(--surface-2); border-color: var(--border-strong); position: relative; }
    .card::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, var(--ud-brand-sky), var(--ud-blue)); border-radius: var(--radius-lg) var(--radius-lg) 0 0; opacity: 0.85; }
    .card:nth-child(2n)::before { background: linear-gradient(90deg, var(--ud-brand-lilac), var(--ud-cyan)); }
    .card:nth-child(3n)::before { background: linear-gradient(90deg, var(--ud-brand-coral), var(--ud-brand-gold)); }
    .card:hover { border-color: color-mix(in srgb, var(--ud-brand-sky) 45%, transparent); box-shadow: 0 8px 32px -12px color-mix(in srgb, var(--ud-brand-sky) 30%, transparent); }
    .card h3 { color: var(--text-primary); font-size: 16px; }
    .card p { color: var(--text-secondary); }

    .client-list { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 36px; }
    .pill {
      padding: 8px 18px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-pill);
      font-size: var(--text-sm);
      color: var(--color-muted);
      transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease;
    }
    .pill:hover { color: var(--color-text); border-color: var(--color-border-strong); }

    .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin-bottom: 56px; }
    .step {
      background: var(--color-bg-card);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 28px;
      transition: border-color var(--duration-base) ease;
    }
    .step:hover { border-color: var(--color-border-strong); }
    .step-num {
      font-family: var(--font-display);
      font-size: 34px;
      font-weight: 600;
      color: var(--color-dim);
      margin-bottom: 16px;
    }

    .stats { display: flex; gap: 56px; flex-wrap: wrap; }
    .stat .num {
      font-family: var(--font-display);
      font-size: 40px;
      font-weight: 600;
      color: var(--color-text);
    }
    .stat .desc { font-size: var(--text-sm); color: var(--color-muted); margin-top: 6px; }

    .cta-final { text-align: center; padding-top: 90px; padding-bottom: 130px; }
    .cta-final h2 {
      font-family: var(--font-display);
      font-size: clamp(30px, 4.5vw, 56px);
      font-weight: 500;
      letter-spacing: -0.025em;
      max-width: 720px;
      margin: 0 auto 28px;
      line-height: 1.12;
    }
    .cta-final p { font-size: 17px; color: var(--color-muted); max-width: 500px; margin: 0 auto 44px; line-height: 1.75; }
  </style>
</head>
<body>

<Navbar />

<main>

  <section class="hero">
    <div class="hero-blobs">
      <BlobField variant="seo" opacity={0.55} blur={14} />
    </div>
    <div class="hero-grid">
      <div class="hero-content">
        <SectionLabel data-gsap="hero-label">SEO Médico y Posicionamiento Local</SectionLabel>
        <h1 data-gsap="hero-title">SEO para doctores que convierte búsquedas en pacientes</h1>
        <p data-gsap="hero-sub">Ayudamos a clínicas, consultorios y especialistas a aparecer cuando un paciente busca atención médica cerca de él: Google, mapas, contenidos confiables y una estrategia pensada para generar citas.</p>
        <div class="actions" data-gsap="hero-actions">
          <Button href="https://wa.me/593961026799" target="_blank" size="lg" variant="stroke">Solicitar diagnóstico</Button>
          <Button href="#enfoque" variant="ghost" size="lg">Ver enfoque</Button>
        </div>
      </div>
      <div class="hero-visual" data-gsap="hero-visual">
        <img src="https://images.unsplash.com/photo-1584438784894-089d6a62b8fa?w=800&q=70" alt="Consultorio médico moderno — SEO para doctores" loading="eager" />
        <div class="hero-visual-glow" aria-hidden="true"></div>
        <div class="hero-visual-badge" data-gsap="hero-badge">
          <span class="hvb-dot"></span> Posicionamiento local en Google
        </div>
      </div>
    </div>
  </section>

  <hr />

  <section id="enfoque">
    <div class="section-split">
      <div class="split-text">
        <SectionLabel data-gsap="hero-label">Posicionamiento para pacientes con intención</SectionLabel>
        <h2 class="section-title">No se trata de tener más visitas. Se trata de aparecer cuando alguien necesita atenderse.</h2>
        <p class="section-desc" data-gsap="reveal">Para un doctor, una búsqueda como "dermatólogo cerca de mí" o "odontólogo en Cuenca" no es tráfico genérico: es una oportunidad de cita. Construimos la estrategia alrededor de esas búsquedas de alta intención.</p>
        <div class="section-split-visual" data-gsap="parallax-wrap">
          <img src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=800&q=70" alt="Doctor revisando historial de paciente" loading="lazy" data-gsap="parallax-img" />
          <div class="img-frame-glow" aria-hidden="true"></div>
        </div>
      </div>
      <div class="split-cards">
        <Card data-gsap="reveal"><h3>Búsquedas con urgencia</h3><p>Capturamos pacientes que ya están comparando especialistas, ubicación, horarios y reseñas.</p></Card>
        <Card data-gsap="reveal"><h3>Presencia en mapas</h3><p>Optimizamos el perfil, categorías, servicios, fotos, publicaciones y señales locales.</p></Card>
        <Card data-gsap="reveal"><h3>Confianza antes de la cita</h3><p>Ordenamos contenido, autoridad y reputación para que la decisión se sienta segura.</p></Card>
      </div>
    </div>
  </section>

  <hr />

  <section>
    <div class="section-split section-split--rev">
      <div class="split-cards">
        <Card data-gsap="reveal"><h3>SEO local y Google Business</h3><p>Especialidad, ubicación, servicios, horarios, reseñas y señales locales para aparecer donde el paciente decide.</p></Card>
        <Card data-gsap="reveal"><h3>Contenido por especialidad</h3><p>Páginas de tratamientos, síntomas, preguntas frecuentes y guías que responden con claridad sin sonar genéricas.</p></Card>
        <Card data-gsap="reveal"><h3>Base técnica y conversión</h3><p>Velocidad, estructura, indexación, arquitectura y llamadas a contacto pensadas para pasar de búsqueda a cita.</p></Card>
        <Card data-gsap="reveal"><h3>Autoridad y reputación</h3><p>Mejoramos señales de confianza: perfiles, reseñas, menciones, enlaces locales y consistencia de marca médica.</p></Card>
      </div>
      <div class="split-text">
        <SectionLabel>Lo que trabajamos para posicionar tu consulta</SectionLabel>
        <h2 class="section-title">Una estrategia completa conecta tu especialidad, tu ciudad y la confianza que un paciente necesita.</h2>
        <p class="section-desc" data-gsap="reveal">Cuatro áreas de trabajo coordinadas para que el SEO se conecte con agenda, llamadas y formularios.</p>
        <div class="section-split-visual" data-gsap="parallax-wrap">
          <img src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?w=800&q=70" alt="Médico con tablet revisando agenda digital" loading="lazy" data-gsap="parallax-img" />
          <div class="img-frame-glow" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="services-horizontal">
    <div class="sh-header">
      <SectionLabel>Nuestros servicios en detalle</SectionLabel>
      <h2 class="section-title">Desplázate — cuatro servicios que conectan búsqueda con pacientes</h2>
    </div>
    <div class="sh-track" data-gsap="sh-track">
      <div class="sh-panel sh-panel--1">
        <div class="sh-num">01</div>
        <h3>SEO local y Google Business</h3>
        <p>Especialidad, ubicación, servicios, horarios, reseñas y señales locales para aparecer donde el paciente decide.</p>
        <div class="sh-img"><img src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=900&q=70" alt="SEO local" loading="lazy" /></div>
      </div>
      <div class="sh-panel sh-panel--2">
        <div class="sh-num">02</div>
        <h3>Contenido por especialidad</h3>
        <p>Páginas de tratamientos, síntomas, preguntas frecuentes y guías que responden con claridad sin sonar genéricas.</p>
        <div class="sh-img"><img src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?w=900&q=70" alt="Contenido médico" loading="lazy" /></div>
      </div>
      <div class="sh-panel sh-panel--3">
        <div class="sh-num">03</div>
        <h3>Base técnica y conversión</h3>
        <p>Velocidad, estructura, indexación, arquitectura y llamadas a contacto pensadas para pasar de búsqueda a cita.</p>
        <div class="sh-img"><img src="https://images.unsplash.com/photo-1584982751601-97dcc096659c?w=900&q=70" alt="Base técnica" loading="lazy" /></div>
      </div>
      <div class="sh-panel sh-panel--4">
        <div class="sh-num">04</div>
        <h3>Autoridad y reputación</h3>
        <p>Mejoramos señales de confianza: perfiles, reseñas, menciones, enlaces locales y consistencia de marca médica.</p>
        <div class="sh-img"><img src="https://images.unsplash.com/photo-1551601651-2a8555f1a136?w=900&q=70" alt="Reputación médica" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <hr />

  <section>
    <SectionLabel>Doctores, clínicas y nuevas formas de búsqueda</SectionLabel>
    <h2 class="section-title">Clientes que ya entienden que el posicionamiento médico va más allá de Google</h2>
    <p class="section-desc">Trabajamos visibilidad para búsquedas locales, respuestas directas, resultados impulsados por IA y consultas donde el paciente espera una recomendación clara antes de agendar.</p>
    <div class="clients-marquee">
      <Marquee speed={45}>
        <span class="mq-item">Dr. Pablo Salamea</span>
        <span class="mq-item">Dr. Diego Chango</span>
        <span class="mq-item">Dra. Lorena Villa</span>
        <span class="mq-item">Dr. Deniss Calderón</span>
        <span class="mq-item">Dr. Juan Carlos Peralvo</span>
        <span class="mq-item">Clínica Alelí</span>
        <span class="mq-item">Hospital del Río</span>
        <span class="mq-item">Dr. Luis Flores</span>
        <span class="mq-item">Gabriela Machado</span>
        <span class="mq-item">Y más…</span>
      </Marquee>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px;margin-top:32px">
      <Card data-gsap="reveal"><div class="card-label">GEO — Generative Engine Optimization</div><h3>También posicionamos en IA</h3><p>Optimización para que tu marca médica sea entendida, citada o recomendada por motores generativos e inteligencia artificial.</p></Card>
      <Card data-gsap="reveal"><div class="card-label">AEO — Answer Engine Optimization</div><h3>Respuestas directas donde el paciente pregunta</h3><p>Fragmentos destacados, búsquedas por voz y consultas tipo "cuál doctor elegir" en Google y asistentes de IA.</p></Card>
    </div>
  </section>

  <hr />

  <section>
    <SectionLabel>Un método claro para escalar la visibilidad médica</SectionLabel>
    <h2 class="section-title">Cuatro fases, resultados medibles</h2>
    <p class="section-desc">No perseguimos volumen vacío. Priorizamos términos con intención clínica, presencia local y rutas claras de contacto.</p>
    <div class="steps">
      <div class="step">
        <div class="step-num">01</div>
        <p>Diagnóstico de búsquedas, competencia, perfil de Google y oportunidades por especialidad.</p>
      </div>
      <div class="step">
        <div class="step-num">02</div>
        <p>Arquitectura de páginas, prioridades locales y plan de contenido para atraer pacientes adecuados.</p>
      </div>
      <div class="step">
        <div class="step-num">03</div>
        <p>Optimización técnica, contenidos, mapas, fichas de servicio y elementos de contacto medibles.</p>
      </div>
      <div class="step">
        <div class="step-num">04</div>
        <p>Seguimiento de rankings, tráfico cualificado, llamadas, formularios y crecimiento por ciudad o tratamiento.</p>
      </div>
    </div>
    <div class="stats">
      <div class="stat">
