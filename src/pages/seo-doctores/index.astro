<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(ScrollTrigger, SplitText);

  document.addEventListener("DOMContentLoaded", () => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) return;

    // HERO TÍTULO — SplitText por caracteres (reveal premium)
    const title = document.querySelector("[data-gsap='hero-title']");
    if (title) {
      const split = SplitText.create(title, { type: "chars,words", mask: "lines" });
      gsap.from(split.chars, {
        y: 40, autoAlpha: 0, rotationX: -90, duration: 0.7, ease: "back.out(1.7)",
        stagger: 0.025,
        scrollTrigger: { trigger: title, start: "top 80%" },
        onComplete: () => split.revert()
      });
    }

    // HERO LABEL + SUB + ACTIONS — entrada escalonada
    gsap.from("[data-gsap='hero-label']", { opacity: 0, y: 15, duration: 0.5, delay: 0.1 });
    gsap.from("[data-gsap='hero-sub']", { opacity: 0, y: 20, duration: 0.7, ease: "power2.out", delay: 0.5 });
    gsap.from("[data-gsap='hero-actions']", { opacity: 0, y: 20, duration: 0.6, ease: "power2.out", delay: 0.7 });

    // BADGE — pop-in con bounce
    gsap.from("[data-gsap='hero-badge']", {
      opacity: 0, scale: 0.8, duration: 0.6, delay: 1, ease: "back.out(2)"
    });

    // HERO VISUAL — parallax suave al scroll
    gsap.to("[data-gsap='hero-visual'] img", {
      y: -60, ease: "none",
      scrollTrigger: { trigger: "[data-gsap='hero-visual']", start: "top bottom", end: "bottom top", scrub: 1 }
    });

    // IMÁGENES DE SECCIÓN — parallax
    gsap.utils.toArray("[data-gsap='parallax-img']").forEach(img => {
      gsap.fromTo(img, { y: -40 }, {
        y: 40, ease: "none",
        scrollTrigger: { trigger: img, start: "top bottom", end: "bottom top", scrub: 1.2 }
      });
    });

    // SCROLL HORIZONTAL — servicios (pin + scrub)
    const track = document.querySelector("[data-gsap='sh-track']");
    if (track) {
      // TÍTULO del horizontal — explosión de letras (scatter 3D) al entrar
      const shTitle = document.querySelector(".sh-header .section-title");
      if (shTitle) {
        const split = SplitText.create(shTitle, { type: "chars", mask: "chars" });
        gsap.from(split.chars, {
          y: 60, rotationX: -90, autoAlpha: 0, scale: 0.6, duration: 0.9,
          ease: "back.out(1.7)", stagger: 0.03,
          scrollTrigger: { trigger: ".sh-header", start: "top 85%" },
          onComplete: () => split.revert()
        });
      }

      const getDistance = () => track.scrollWidth - window.innerWidth;
      const tween = gsap.to(track, {
        x: () => -getDistance(),
        ease: "none",
        scrollTrigger: {
          trigger: ".services-horizontal",
          start: "top top",
          end: () => "+=" + getDistance(),
          pin: true,
          scrub: 1,
          invalidateOnRefresh: true,
          anticipatePin: 1
        }
      });
      // PANELES — se despliegan apilados (rotación 3D + stagger) al iniciar
      gsap.from(".sh-panel", {
        rotationY: -18, opacity: 0, x: 60, duration: 0.8, ease: "power3.out",
        stagger: 0.15,
        scrollTrigger: { trigger: ".services-horizontal", start: "top 90%" }
      });
      // cleanup en resize
      ScrollTrigger.addEventListener("refreshInit", () => tween.invalidate());
    }

    // SECTION TITLES — SplitText por palabras (reveal al scrollear), salvo el del horizontal
    gsap.utils.toArray(".section-title").forEach(h => {
      if (h.closest(".sh-header")) return; // el horizontal tiene su propia explosión de chars
      const split = SplitText.create(h, { type: "words" });
      gsap.from(split.words, {
        y: 30, autoAlpha: 0, duration: 0.6, ease: "power3.out", stagger: 0.05,
        scrollTrigger: { trigger: h, start: "top 82%" },
        onComplete: () => split.revert()
      });
    });

    // CARDS — reveal con stagger
    gsap.utils.toArray("[data-gsap='reveal']").forEach(el => {
      gsap.from(el, {
        opacity: 0, y: 50, duration: 0.7, ease: "power3.out",
        scrollTrigger: { trigger: el, start: "top 88%" }
      });
    });

    // CTA FINAL — reveal
    const cta = document.querySelector(".cta-final");
    if (cta) {
      gsap.from(cta, {
        opacity: 0, y: 40, scale: 0.98, duration: 0.8, ease: "power3.out",
        scrollTrigger: { trigger: cta, start: "top 80%" }
      });
    }
  });
</script>

</body>
</html>
