---
// Home nativo — Hero nuevo (aprobado por Mau) + secciones del ORIGINAL framer
// inyectadas 1:1 desde src/html/home-native.html (clases ud-, imágenes locales).
import fs from "fs";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import HomeHero from "../components/home/HomeHero.astro";
import BlogSection from "../components/home/BlogSection.astro";
import { sanitizeFramerHtml } from "../lib/framer-html";

let html = fs.readFileSync("src/html/home-native.html", "utf-8");

// Quitar styles inline (el CSS vive en public/home.css)
html = html.replace(/<style[^>]*>[\s\S]*?<\/style>/gi, "");

// Forzar visibilidad (estados que el player de Framer animaba) — NO tocar los
// estilos de layout, solo los estados de opacidad/transform de "appear".
html = sanitizeFramerHtml(html);
html = html.replace(/transform:\s*translateY\(-?\d+px\)/gi, "transform:none");
// Los estados de entrada del player usan translateX(±Npx) con opacity:0.
// Sin player quedan congelados y desplazan el texto (se corta en overflow:hidden).
// Solo limpiamos los que NO son layout (el centrado usa translateX(-50%)).
html = html.replace(/opacity:1;\s*transform:\s*translateX\(-?\d+px\)/gi, "opacity:1;transform:none");
html = html.replace(/will-change:transform;opacity:1;\s*transform:\s*translateX\(-?\d+px\)/gi, "will-change:transform;opacity:1;transform:none");
html = html.replace(/transform:\s*translateX\(-?\d+px\)\s*rotate\([^)]*\)/gi, "transform:none");
html = html.replace(/transform:\s*perspective\([^)]*\)\s*translateX\(-?\d+px\)\s*translateY\([^)]*\)\s*scale\([^)]*\)/gi, "transform:none");

// Eliminar variantes de breakpoint no-desktop del HTML (duplican contenido en
// el HTML crudo que leen los crawlers: "Más de 12 años ×3", etc.). En desktop
// (72rtr7) la variante activa es la que NO tiene hidden-72rtr7.
const eliminarVariantesNoDesktop = (doc) => {
  const re = /<div class="ssr-variant[^"]*hidden-72rtr7[^"]*">/g;
  let out = "";
  let last = 0;
  let m;
  while ((m = re.exec(doc)) !== null) {
    const start = m.index;
    out += doc.slice(last, start);
    // contar divs con indexOf (evita el bug de lastIndex compartido)
    let i = doc.indexOf("<div", start);
    let depth = 0;
    let end = -1;
    while (i !== -1) {
      const close = doc.indexOf("</div>", i);
      if (close === -1) break;
      // contar <div entre i y close
      let j = i;
      while (j < close) {
        const d = doc.indexOf("<div", j);
        if (d === -1 || d >= close) break;
        depth++;
        j = d + 4;
      }
      depth--;
      if (depth <= 0) { end = close + "</div>".length; break; }
      i = close + 6;
    }
    last = end !== -1 ? end : m.index + m[0].length;
    if (end === -1) { re.lastIndex = last; }
  }
  out += doc.slice(last);
  return out;
};
html = eliminarVariantesNoDesktop(html);

// Extraer las secciones del original (Product section → Bannner), excluyendo
// TODO lo anterior (hero original + scripts de Framer) y el Blog estático.
const body = html.replace(/<body[^>]*>|<\/body>/gi, "");
const productStart = body.indexOf('data-ud-name="Product section"');
const blogStart = body.indexOf('<section class="ud-o78dmu"');
// retroceder al <section completo de la Product section
const secStart = productStart > 0 ? body.lastIndexOf("<section", productStart) : -1;
const fromProduct = secStart >= 0 ? body.slice(secStart) : body;
const secciones = blogStart > 0 ? fromProduct.slice(0, blogStart - secStart) : fromProduct;
// Schema.org (Organization, WebSite, LocalBusiness, FAQ, etc.) del HTML
// original — se pierde al extraer solo el body. Se re-inyecta en el head.
const schemas = html.match(/<script type="application\/ld\+json">[\s\S]*?<\/script>/gi) || [];
---
<html lang="es-EC">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Agencia UX/UI para Fintechs y Bancos en Latinoamérica | UserDesigners</title>
  <meta name="description" content="Agencia de UX/UI especializada en Fintechs y Banca digital de Latinoamérica. Más de 12 años diseñando productos digitales que convierten." />
  <link rel="canonical" href="https://www.userdesigners.com/" />
  <link rel="icon" href="/assets/local/o5LtTMyVT0hoY6m1F1q3smw3kq4.png" />
  <meta property="og:title" content="UserDesigners | Agencia UX/UI para Fintechs y Bancos" />
  <meta property="og:description" content="Agencia de UX/UI especializada en Fintechs y Banca digital de Latinoamérica. Más de 12 años diseñando productos digitales que convierten." />
  <meta property="og:url" content="https://www.userdesigners.com/" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://www.userdesigners.com/assets/local/bUYh6jy5kjctf6KEV3vRnONhegI.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="UserDesigners | Agencia UX/UI para Fintechs y Bancos" />
  <meta name="twitter:description" content="Agencia de UX/UI especializada en Fintechs y Banca digital de Latinoamérica. Más de 12 años diseñando productos digitales que convierten." />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Familjen+Grotesk:wght@400;500;600&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Familjen+Grotesk:wght@400;500;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Familjen+Grotesk:wght@400;500;600&display=swap" /></noscript>
    <link rel="stylesheet" href="/styles/tokens.css" />
    <link rel="stylesheet" href="/home.css" />
    {/* Schema.org del HTML original (Organization, LocalBusiness, FAQ...) */}
    {schemas.map((s) => (
      <Fragment set:html={s} />
    ))}

    <style>
      /* Normalizar botones del HTML original al estilo del DS Button stroke */
      .ud-tqfFO a[data-ud-name="Bottom"],
      .ud-tqfFO a[data-ud-name="Button"],
      .ud-tqfFO [data-ud-name="Bottom"] {
        color: #fff !important;
        font-family: var(--font-body) !important;
        font-size: 14px !important;
        font-weight: 500 !important;
        letter-spacing: -0.01em !important;
        text-decoration: none !important;
      }
    </style>
  </head>
  <body style="background:#030303;margin:0;overflow-x:hidden">
    <Navbar />
    <HomeHero />
    {/* El root framer (ud-tqfFO) envuelve las secciones: los selectores de
        home.css dependen de ese ancestro (.ud-tqfFO .ud-5r60op, etc.) */}
    <div class="ud-tqfFO ud-72rtr7" data-ud-root="" style="min-height:100vh;width:100%;max-width:1440px">
      <Fragment set:html={secciones} />
    </div>
    <BlogSection />
    <Footer />

    <script is:inline>
      // Marquee de logos del hero del HTML (carrusel que el player animaba)
      document.addEventListener("DOMContentLoaded", () => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const logoWrap = document.querySelector(".ud-12n3d87-container");
        if (logoWrap) {
          const track = logoWrap.querySelector("section");
          if (track && track.scrollWidth > logoWrap.clientWidth * 1.3) {
            const clone = track.cloneNode(true);
            track.appendChild(clone);
            const distance = track.scrollWidth / 2;
            let x = 0;
            const step = () => {
              x -= 0.8;
              if (x <= -distance) x = 0;
              track.style.transform = `translateX(${x}px)`;
              requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          }
        }
      });
    </script>
  </body>
</html>
